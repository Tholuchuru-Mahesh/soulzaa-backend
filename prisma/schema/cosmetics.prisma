/// A catalog cosmetic. `mediaUrl`/`thumbnailUrl` are resolved by the client.
/// `transferable` propagates to the backpack item on grant. Unique per
/// (type, name) so seeds/admin upserts are idempotent by name.
model Cosmetic {
  id           String         @id @default(uuid()) @db.Uuid
  type         CosmeticType
  name         String
  mediaUrl     String?
  thumbnailUrl String?
  rarity       CosmeticRarity @default(COMMON)
  transferable Boolean        @default(false)
  enabled      Boolean        @default(true)
  sortOrder    Int            @default(0)
  metadata     Json?
  createdBy    String?        @db.Uuid
  updatedBy    String?        @db.Uuid
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  isPremium    Boolean        @default(false)
  /// Gold-coin price. Purchasable only when `isPremium` and `price > 0`.
  price        Int            @default(0)
  userCosmetics UserCosmetic[]

  @@unique([type, name])
  @@index([enabled, type])
  @@index([isPremium, enabled])
  @@map("cosmetics")
}

model UserCosmetic {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @db.Uuid
  cosmeticId   String         @db.Uuid
  equipped     Boolean        @default(false)
  acquiredAt   DateTime       @default(now())
  expiresAt    DateTime?
  updatedAt    DateTime       @updatedAt

  cosmetic     Cosmetic       @relation(fields: [cosmeticId], references: [id], onDelete: Cascade)

  @@unique([userId, cosmeticId])
  @@index([userId, equipped])
  @@map("user_cosmetics")
}

/// Immutable ledger of premium-cosmetic purchases. `idempotencyKey` (a client
/// key or a generated one) makes a purchase exactly-once. Written after the
/// wallet debit + backpack grant succeed.
model CosmeticPurchase {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  cosmeticId     String   @db.Uuid
  price          BigInt
  walletTxnId    String?  @db.Uuid
  backpackItemId String?  @db.Uuid
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([cosmeticId])
  @@map("cosmetic_purchases")
}

enum CosmeticType {
  FRAME
  BADGE
  ENTRANCE_EFFECT
  THEME
  DECORATION
}

enum CosmeticRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}
