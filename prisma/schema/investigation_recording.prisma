model InvestigationRecording {
  id              String              @id @default(uuid()) @db.Uuid
  evidenceId      String              @unique
  moderatorId     String              @db.Uuid
  targetUserId    String              @db.Uuid
  roomId          String?             @db.Uuid
  liveStreamId    String?             @db.Uuid
  /// Nullable: a recording opened at room-join time (before the moderator has
  /// observed the violation) has no reason yet — it's finalized by
  /// `completeRecording` once the moderator selects one. Always non-null by
  /// the time `status` is COMPLETED.
  violationReason String?
  actionTaken     String?
  evidencePayload Json?
  status          InvestigationStatus @default(ACTIVE)
  startedAt       DateTime            @default(now())
  completedAt     DateTime?
  durationSeconds Int?
  recordingUrl    String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([moderatorId])
  @@index([targetUserId])
  @@index([liveStreamId])
  @@index([roomId])
  @@index([status])
  @@index([moderatorId, targetUserId, status])
  @@map("investigation_recordings")
}
