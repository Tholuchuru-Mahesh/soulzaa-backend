model RankingSnapshot {
  id        String   @id @default(uuid()) @db.Uuid
  type      String
  period    String
  dateKey   String
  targetId  String   @db.Uuid
  rank      Int
  score     BigInt
  createdAt DateTime @default(now())

  @@unique([type, period, dateKey, targetId])
  @@index([type, period, dateKey, rank])
  @@map("ranking_snapshots")
}
