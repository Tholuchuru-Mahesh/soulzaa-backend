// ============================================================
// Rankings — leaderboard snapshots & config (live data in Redis ZSETs)
// Owned by the "rankings" module.
// No cross-module relations — reference other domains by id.
// ============================================================

model RankingSnapshot {
  id        String   @id @default(uuid()) @db.Uuid
  type      String // E.g., "gifters", "receivers", "families", "streamers"
  period    String // E.g., "daily", "weekly", "monthly"
  dateKey   String // E.g., "20260707", "2026W28", "202607"
  targetId  String   @db.Uuid // Reference to user_id or family_id
  rank      Int
  score     BigInt
  createdAt DateTime @default(now())

  @@unique([type, period, dateKey, targetId])
  @@index([type, period, dateKey, rank])
  @@map("ranking_snapshots")
}
