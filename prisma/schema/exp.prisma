// ============================================================
// EXP & Levels (AR-7) — user and room experience points, immutable
// EXP ledgers, and the level threshold + reward configs. Owned by the
// "exp" module. EXP accrues from gifts/room activity (consumed from
// domain events) and admin awards; crossing a level threshold grants
// the configured rewards (free coins + cosmetics via the backpack).
// No cross-module relations — reference users/rooms by id.
// ============================================================

/// Where an EXP award came from (PRD EXP sources).
enum ExpSource {
  DAILY_LOGIN
  GIFT_SENT
  GIFT_RECEIVED
  ROOM_JOIN
  LIVE_STREAM
  GAME
  EVENT
  TASK
  ADMIN
}

/// A user's aggregate EXP + current level (denormalised for fast reads).
model UserExp {
  userId    String   @id @db.Uuid
  totalExp  BigInt   @default(0)
  level     Int      @default(1)
  updatedAt DateTime @updatedAt

  @@map("user_exp")
}

/// Append-only, immutable ledger of every user EXP award. `idempotencyKey` makes
/// awarding exactly-once (a replayed event maps to the same row).
model ExpLog {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  amount         Int
  source         ExpSource
  referenceType  String?
  referenceId    String?   @db.Uuid
  idempotencyKey String    @unique
  totalAfter     BigInt
  createdAt      DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("exp_logs")
}

/// Admin-managed user level ladder. `minExp` is the cumulative EXP to reach the
/// level; `rewards` is a JSON array of `{ kind, coins?, currency?, cosmeticId? }`
/// granted on reaching it.
model LevelConfig {
  level     Int      @id
  minExp    BigInt
  title     String?
  rewards   Json     @default("[]")
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("level_configs")
}

/// A room's aggregate EXP + current level (room progression).
model RoomExp {
  roomId    String   @id @db.Uuid
  totalExp  BigInt   @default(0)
  level     Int      @default(1)
  updatedAt DateTime @updatedAt

  @@map("room_exp")
}

/// Append-only ledger of room EXP awards.
model RoomExpLog {
  id             String    @id @default(uuid()) @db.Uuid
  roomId         String    @db.Uuid
  amount         Int
  source         ExpSource
  referenceId    String?   @db.Uuid
  idempotencyKey String    @unique
  totalAfter     BigInt
  createdAt      DateTime  @default(now())

  @@index([roomId, createdAt])
  @@map("room_exp_logs")
}

/// Admin-managed room level ladder (thresholds + optional title/perks).
model RoomLevelConfig {
  level     Int      @id
  minExp    BigInt
  title     String?
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("room_level_configs")
}
