// ============================================================
// Soulzaa — Enterprise Level & Experience Engine Schema
// Entities: UserLevel, LevelDefinition, ExperienceSource, ExperienceHistory, LevelStatistics, LevelAudit, LevelConfiguration
// ============================================================

/// User Level & EXP Aggregate
model UserLevel {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  currentLevel Int      @default(1)
  lifetimeExp  BigInt   @default(0)
  dailyExp     BigInt   @default(0)
  weeklyExp    BigInt   @default(0)
  monthlyExp   BigInt   @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([currentLevel])
  @@index([lifetimeExp])
  @@map("user_levels")
}

/// Level Threshold & Title Definition
model LevelDefinition {
  id          String   @id @default(uuid()) @db.Uuid
  level       Int      @unique
  title       String?
  requiredExp BigInt   @default(0)
  icon        String?
  badgeUrl    String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("level_definitions")
}

/// Configurable Experience Award Source
model ExperienceSource {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  baseExp   Int      @default(10)
  dailyCap  Int      @default(0)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("experience_sources")
}

/// Immutable Experience Transaction & Replay Protection Ledger
model ExperienceHistory {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  amount         Int
  sourceCode     String
  idempotencyKey String   @unique
  referenceType  String?
  referenceId    String?
  previousLevel  Int
  newLevel       Int
  totalExpAfter  BigInt
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([sourceCode])
  @@map("experience_histories")
}

/// Pre-aggregated Level & EXP Statistics
model LevelStatistics {
  id               String   @id @default(uuid()) @db.Uuid
  period           String   @default("DAILY")
  dateKey          String
  totalExpGranted  BigInt   @default(0)
  levelUpsCount    Int      @default(0)
  activeUsersCount Int      @default(0)
  updatedAt        DateTime @updatedAt

  @@unique([period, dateKey])
  @@map("level_statistics")
}

/// Operational Audit Log for Level Engine Events
model LevelAudit {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  details   Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("level_audits")
}

/// Dynamic Level & Experience Configuration Parameters
model LevelConfiguration {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("level_configurations")
}
