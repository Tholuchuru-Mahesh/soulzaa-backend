// ============================================================
// Audio Room PK Battles (AR-10) — 1v1 and Team gift-score battles.
// Owned by the "audio_rooms" module. Two sides (RED/BLUE) accumulate
// score from gifts sent to their participants (from GiftSentEvent)
// while the timer runs; at expiry the higher side wins, winners get a
// badge (backpack) + a PK ranking point, and the match is recorded.
// Immutable contribution + reward ledgers. No cross-module relations.
// ============================================================

enum PkMode {
  ONE_VS_ONE
  TEAM
}

enum PkSide {
  RED
  BLUE
}

enum PkStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

/// Battle outcome. RED/BLUE = that side won; DRAW = equal score.
enum PkResult {
  RED
  BLUE
  DRAW
}

/// A PK battle in a room. `redScore`/`blueScore` accumulate contributed gift
/// value; at `endsAt` the expiry monitor completes it. At most one ACTIVE battle
/// per room, enforced in the service.
model PkBattle {
  id              String    @id @default(uuid()) @db.Uuid
  roomId          String    @db.Uuid
  mode            PkMode
  status          PkStatus  @default(ACTIVE)
  durationSeconds Int
  startedBy       String    @db.Uuid
  redScore        BigInt    @default(0)
  blueScore       BigInt    @default(0)
  result          PkResult?
  startedAt       DateTime  @default(now())
  endsAt          DateTime
  completedAt     DateTime?

  @@index([roomId, status])
  @@index([status, endsAt])
  @@map("pk_battles")
}

/// A participant on a side. `score` is their personal contribution to the side.
model PkParticipant {
  id        String   @id @default(uuid()) @db.Uuid
  battleId  String   @db.Uuid
  roomId    String   @db.Uuid
  userId    String   @db.Uuid
  side      PkSide
  score     BigInt   @default(0)
  createdAt DateTime @default(now())

  @@unique([battleId, userId])
  @@index([battleId])
  @@map("pk_participants")
}

/// Append-only ledger of every gift contribution to a battle side.
model PkContribution {
  id            String   @id @default(uuid()) @db.Uuid
  battleId      String   @db.Uuid
  roomId        String   @db.Uuid
  participantId String   @db.Uuid
  side          PkSide
  contributorId String   @db.Uuid
  amount        BigInt
  giftTxnId     String?  @db.Uuid
  createdAt     DateTime @default(now())

  @@index([battleId])
  @@index([participantId])
  @@map("pk_contributions")
}

/// Immutable record of a winner reward (badge) distributed at battle end.
model PkReward {
  id             String   @id @default(uuid()) @db.Uuid
  battleId       String   @db.Uuid
  roomId         String   @db.Uuid
  userId         String   @db.Uuid
  side           PkSide
  cosmeticId     String?  @db.Uuid
  backpackItemId String?  @db.Uuid
  createdAt      DateTime @default(now())

  @@index([battleId])
  @@index([userId])
  @@map("pk_rewards")
}
