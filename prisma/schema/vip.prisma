// ============================================================
// Soulzaa — Enterprise VIP Membership Engine Schema
// Entities: VipTier, VipMembership, VipSubscription, VipBenefit, VipReward, VipHistory, VipAudit, VipStatistics, VipConfiguration
// ============================================================

/// VIP Tier Definition
model VipTier {
  id                 String   @id @default(uuid()) @db.Uuid
  level              Int      @unique
  name               String
  displayOrder       Int      @default(1)
  requiredExp        BigInt   @default(0)
  requiredSpending   BigInt   @default(0)
  subscriptionType   String   @default("MONTHLY")
  durationDays       Int      @default(30)
  price              BigInt   @default(0)
  badge              String?
  frame              String?
  entranceEffect     String?
  chatBubble         String?
  nameColor          String?
  profileDecoration  String?
  seatDecoration     String?
  giftDiscount       Float    @default(0.0)
  storeDiscount      Float    @default(0.0)
  dailyRewards       Json     @default("[]")
  weeklyRewards      Json     @default("[]")
  monthlyRewards     Json     @default("[]")
  maxRooms           Int      @default(1)
  priorityMatching   Boolean  @default(false)
  exclusiveGifts     Json     @default("[]")
  exclusiveEvents    Json     @default("[]")
  visibility         Boolean  @default(true)
  status             String   @default("ACTIVE")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("vip_tiers")
}

/// Active User VIP Membership
model VipMembership {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @unique @db.Uuid
  tierId               String    @db.Uuid
  level                Int       @default(1)
  status               String    @default("ACTIVE")
  autoRenew            Boolean   @default(false)
  expGained            BigInt    @default(0)
  totalSpent           BigInt    @default(0)
  startedAt            DateTime  @default(now())
  expiresAt            DateTime
  lastClaimedDailyAt   DateTime?
  lastClaimedWeeklyAt  DateTime?
  lastClaimedMonthlyAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@map("vip_memberships")
}

/// VIP Subscription Transaction Audit Ledger
model VipSubscription {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  tierId       String   @db.Uuid
  pricePaid    BigInt   @default(0)
  action       String
  gifterUserId String?  @db.Uuid
  durationDays Int      @default(30)
  startedAt    DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("vip_subscriptions")
}

/// VIP Entitlement / Benefit Parameter
model VipBenefit {
  id        String   @id @default(uuid()) @db.Uuid
  tierId    String   @db.Uuid
  type      String
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vip_benefits")
}

/// Claimed Reward Audit Record
model VipReward {
  id           String   @id @default(uuid()) @db.Uuid
  membershipId String   @db.Uuid
  userId       String   @db.Uuid
  rewardType   String
  rewardData   Json
  claimedAt    DateTime @default(now())

  @@index([userId, rewardType])
  @@map("vip_rewards")
}

/// VIP Member Lifecycle History
model VipHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  action    String
  details   Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("vip_histories")
}

/// Operational Audit Log for VIP Engine Events
model VipAudit {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  details   Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("vip_audits")
}

/// Pre-aggregated statistics for VIP memberships
model VipStatistics {
  id             String   @id @default(uuid()) @db.Uuid
  period         String   @default("DAILY")
  dateKey        String
  purchasesCount Int      @default(0)
  activeVipCount Int      @default(0)
  expiredCount   Int      @default(0)
  renewalsCount  Int      @default(0)
  upgradesCount  Int      @default(0)
  totalRevenue   BigInt   @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([period, dateKey])
  @@map("vip_statistics")
}

/// Dynamic VIP Configuration Parameters
model VipConfiguration {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("vip_configurations")
}
