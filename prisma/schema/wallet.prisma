/// Wallet Account Entity. Balances are BigInt to scale to platform-wide lifetime volumes.
///
/// Three-currency model (PRD §7):
/// goldBalance    — Gold Coin balance (premium, purchased with real money)
/// diamondBalance — Diamond balance   (creator earnings; withdrawal-eligible)
/// gameBalance    — Game Coin balance  (casual-game free coins; non-withdrawable)
///
/// Legacy columns kept for row-level backward compatibility:
/// freeBalance     → deprecated alias for gameBalance
/// earningsBalance → deprecated alias for diamondBalance
///
/// IMPORTANT: availableBalance is GOLD-only. It must never aggregate across currencies.
/// Each currency's spendable quantity is its own sub-balance field (goldBalance /
/// diamondBalance / gameBalance). Cross-currency aggregation is explicitly forbidden
/// by the PRD. Do not re-introduce the gold+free sum that was here previously.
model Wallet {
  userId                  String              @unique @db.Uuid
  goldBalance             BigInt              @default(0)
  /// @deprecated use gameBalance
  freeBalance             BigInt              @default(0)
  /// @deprecated use diamondBalance
  earningsBalance         BigInt              @default(0)
  totalRecharged          BigInt              @default(0)
  totalGiftsSentValue     BigInt              @default(0)
  totalGiftsReceivedValue BigInt              @default(0)
  totalSpent              BigInt              @default(0)
  version                 Int                 @default(0)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  /// Gold-only available balance (NOT an aggregate across currencies).
  availableBalance        BigInt              @default(0)
  id                      String              @id @default(uuid()) @db.Uuid
  lockedBalance           BigInt              @default(0)
  pendingBalance          BigInt              @default(0)
  reservedBalance         BigInt              @default(0)
  status                  WalletStatus        @default(ACTIVE)
  type                    WalletType          @default(USER_WALLET)
  diamondBalance          BigInt              @default(0)
  gameBalance             BigInt              @default(0)
  ledgerEntries           LedgerEntry[]
  reservations            WalletReservation[]

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([version])
  @@map("wallets")
}

/// Central Wallet Transaction Record for high-level operations
model WalletTransaction {
  id                  String            @id @default(uuid()) @db.Uuid
  currency            WalletCurrency    @default(GOLD)
  amount              BigInt
  referenceType       String?
  referenceId         String?           @db.Uuid
  idempotencyKey      String            @unique
  metadata            Json?
  createdBy           String?           @db.Uuid
  createdAt           DateTime          @default(now())
  destinationWalletId String?           @db.Uuid
  sourceWalletId      String?           @db.Uuid
  status              TransactionStatus @default(COMPLETED)
  transactionType     TransactionType
  ledgerEntries       LedgerEntry[]

  @@index([sourceWalletId, createdAt])
  @@index([destinationWalletId, createdAt])
  @@index([referenceType, referenceId])
  @@map("wallet_transactions")
}

/// Append-only, immutable double-entry ledger record. Never updated or deleted.
model LedgerEntry {
  id            String            @id @default(uuid()) @db.Uuid
  transactionId String            @db.Uuid
  walletId      String            @db.Uuid
  type          WalletEntryType
  currency      WalletCurrency
  reason        WalletTxnReason   @default(SYSTEM_TRANSFER)
  amount        BigInt
  balanceBefore BigInt
  balanceAfter  BigInt
  referenceType String?
  referenceId   String?           @db.Uuid
  description   String?
  actorId       String?           @db.Uuid
  createdAt     DateTime          @default(now())
  transaction   WalletTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  wallet        Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([transactionId])
  @@index([referenceType, referenceId])
  @@map("ledger_entries")
}

/// Temporary Coin Reservation Hold (for Games, Withdrawals, Treasure Boxes, Checkouts)
model WalletReservation {
  id            String            @id @default(uuid()) @db.Uuid
  walletId      String            @db.Uuid
  currency      WalletCurrency    @default(GOLD)
  amount        BigInt
  purpose       String
  status        ReservationStatus @default(HELD)
  referenceType String?
  referenceId   String?           @db.Uuid
  expiresAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  wallet        Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, status])
  @@index([expiresAt])
  @@map("wallet_reservations")
}

/// Operational Audit Log for Wallet locks, balance reconciliations, and limit events
model WalletAudit {
  id        String   @id @default(uuid()) @db.Uuid
  walletId  String   @db.Uuid
  action    String
  details   Json?
  actorId   String?  @db.Uuid
  createdAt DateTime @default(now())

  @@index([walletId])
  @@index([createdAt])
  @@map("wallet_audits")
}

/// Currencies held in a wallet.
/// Three-currency model (PRD §2):
/// GOLD    — premium spending currency (purchased with real money)
/// DIAMOND — creator earnings currency (received via gifts; withdrawal-eligible)
/// GAME    — free/casual-game currency (earned through tasks, login, events; non-withdrawable)
///
/// Legacy aliases kept for backward-compatibility with existing data rows:
/// FREE     → deprecated alias for GAME
/// EARNINGS → deprecated alias for DIAMOND
/// Do NOT use FREE or EARNINGS in new code; use GAME / DIAMOND instead.
enum WalletCurrency {
  GOLD
  /// @deprecated — use GAME instead. Kept so existing ledger rows remain valid.
  FREE
  /// @deprecated — use DIAMOND instead. Kept so existing ledger rows remain valid.
  EARNINGS
  DIAMOND
  GAME
}

/// Category of Wallet Account
enum WalletType {
  USER_WALLET
  HOST_WALLET
  AGENCY_WALLET
  COIN_SELLER_WALLET
  TREASURY_WALLET
  SYSTEM_WALLET
  ESCROW_WALLET
  GAME_ESCROW_WALLET
}

/// Operational state of a wallet
enum WalletStatus {
  ACTIVE
  LOCKED
  FROZEN
  SUSPENDED
}

/// Direction of a double-entry ledger record
enum WalletEntryType {
  CREDIT
  DEBIT
}

/// Status of a wallet reservation hold
enum ReservationStatus {
  HELD
  RELEASED
  CONSUMED
  EXPIRED
}

/// Status of a wallet transaction
enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REVERSED
}

/// High-level Transaction Type classification
enum TransactionType {
  PURCHASE
  GIFT
  REWARD
  BONUS
  TREASURE
  WITHDRAWAL
  DEPOSIT
  REFUND
  SETTLEMENT
  PENALTY
  ADJUSTMENT
  TRANSFER
  GAME_ENTRY
  GAME_REWARD
  ENTRY_FEE
}

/// Why a ledger entry was written (drives reporting/reconciliation).
/// Three-currency groupings:
/// GOLD_*    — movements of Gold Coin (premium, purchasable)
/// DIAMOND_* — movements of Diamond (creator earnings, withdrawal-eligible)
/// GAME_*    — movements of Game Coin (free casual-game coin)
enum WalletTxnReason {
  RECHARGE
  GIFT_SEND
  GIFT_RECEIVE
  GIFT_REFUND
  ADMIN_CREDIT
  ADMIN_DEBIT
  TREASURE_BOX
  GAME_STAKE
  GAME_PAYOUT
  VIP_PURCHASE
  EVENT_REWARD
  COSMETIC_PURCHASE
  PREMIUM_SEAT
  GAME_REFUND
  LUCKY_PACKET_CREATE
  LUCKY_PACKET_CLAIM
  LUCKY_PACKET_REFUND
  SPIN_WHEEL_REWARD
  CASINO_BET
  CASINO_WIN
  CASINO_REFUND
  PK_REWARD
  HOST_EARNING
  AGENCY_COMMISSION
  COIN_SELLER_COMMISSION
  WITHDRAWAL
  VIP_RENEWAL
  SYSTEM_TRANSFER
  RESERVATION_HOLD
  RESERVATION_RELEASE
  RESERVATION_CONSUME
  ATTENDANCE_REWARD
  PK_BATTLE_RECEIVER_BONUS
  /// Coins reversed because Play voided the purchase that created them.
  PURCHASE_REVERSAL
  /// Gold Coins credited by Coin Seller to user (PRD §19).
  COIN_SELLER_CREDIT
  /// Gold Coin cashback earned by creator on gift receipt (PRD §5).
  GIFT_CASHBACK
  /// Diamond earned by creator from a gift settlement (PRD §4).
  DIAMOND_GIFT_EARNING
  /// Diamond reserved when a withdrawal request is submitted (PRD §21).
  DIAMOND_WITHDRAWAL_RESERVE
  /// Diamond settled after withdrawal is completed (PRD §21).
  DIAMOND_WITHDRAWAL_COMPLETED
  /// Diamond returned if withdrawal is rejected or cancelled (PRD §21).
  DIAMOND_WITHDRAWAL_REVERSED
  /// Manual Diamond adjustment by Super Admin / Admin.
  DIAMOND_ADJUSTMENT
  /// Game Coins earned via daily login reward (PRD §6).
  GAME_DAILY_LOGIN
  /// Game Coins earned via daily task completion (PRD §6).
  GAME_TASK_REWARD
  /// Game Coins earned via in-platform event (PRD §6).
  GAME_EVENT_REWARD
  /// Game Coins earned via lucky spin (PRD §6).
  GAME_SPIN_REWARD
  /// Game Coins earned via achievement milestone (PRD §6).
  GAME_ACHIEVEMENT_REWARD
  /// Game Coins earned via promotional campaign (PRD §6).
  GAME_PROMOTIONAL_REWARD
  /// Game Coins staked as entry fee for a casual game.
  GAME_COIN_STAKE
  /// Game Coins paid out as win from a casual game.
  GAME_COIN_WIN
  /// Game Coins refunded when a casual game is cancelled.
  GAME_COIN_REFUND
  /// Gold Coins debited for entering a paid Video Room broadcast session.
  VIDEO_ROOM_ENTRY_FEE
  /// Gold Coins refunded if system failed to grant video room entry.
  VIDEO_ROOM_ENTRY_REFUND
  /// Diamond/Soul Gems credited to host from video room entry fee.
  VIDEO_ROOM_ENTRY_EARNING
}
