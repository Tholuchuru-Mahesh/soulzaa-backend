// ============================================================
// Privacy & Safety — settings, blocking, preferences
// Owned by the "privacy" module. Authoritative store for per-user
// visibility/permission levels, the block list, and general
// preferences. Checks are cached in Redis; other domains consult
// PRIVACY_SERVICE. No cross-module relations.
// ============================================================

enum PrivacyLevel {
  EVERYONE
  FRIENDS_ONLY
  FOLLOWERS_ONLY
  NOBODY
}

/// Per-user visibility + permission levels. One row per user, created
/// on first read (ensureDefaults) — everything defaults to EVERYONE.
model PrivacySettings {
  userId                  String       @id @db.Uuid
  onlineStatus            PrivacyLevel @default(EVERYONE)
  lastSeen                PrivacyLevel @default(EVERYONE)
  profileVisibility       PrivacyLevel @default(EVERYONE)
  callPermission          PrivacyLevel @default(EVERYONE)
  messagePermission       PrivacyLevel @default(EVERYONE)
  friendRequestPermission PrivacyLevel @default(EVERYONE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("privacy_settings")
}

/// A block edge: `blockerId` has blocked `blockedId`. Checks consider
/// both directions (a block hides each user from the other).
model BlockedUser {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  reason    String?
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocked_users")
}

/// General per-user preferences (non-privacy toggles). Distinct from
/// privacy_settings; grows as features land.
model UserPreferences {
  userId       String  @id @db.Uuid
  searchable   Boolean @default(true)
  showActivity Boolean @default(true)
  readReceipts Boolean @default(true)
  allowTagging Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_preferences")
}
