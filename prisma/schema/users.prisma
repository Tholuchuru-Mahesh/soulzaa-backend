/// The canonical account/identity row. Auth reads/writes this only
/// through IUsersService (USERS_SERVICE) — never via Prisma directly.
model User {
  id                String         @id @default(uuid()) @db.Uuid
  username          String         @unique
  email             String?        @unique
  mobile            String?        @unique
  fullName          String?
  gender            Gender?
  dateOfBirth       DateTime?      @db.Date
  country           String?
  preferredLanguage String?
  roles             PlatformRole[] @default([USER])
  isGuest           Boolean        @default(false)
  status            AccountStatus  @default(ACTIVE)
  emailVerifiedAt   DateTime?
  mobileVerifiedAt  DateTime?
  createdBy         String?        @db.Uuid
  updatedBy         String?        @db.Uuid
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?
  countryId         String?        @db.Uuid
  stateId           String?        @db.Uuid
  /// Kept for consumers outside moderation that still scope by region:
  /// role-request routing, campaigns, events, content-requests, support
  /// tickets. Moderator RoleScope stops at State (see WorkforceScopeService)
  /// but this column itself was never moderation-exclusive.
  regionId          String?        @db.Uuid
  /// True for platform staff accounts that must never surface to ordinary
  /// users. Denormalised from the ADMIN / SUPER_ADMIN role assignment and
  /// written solely by the admin-identity module, so read paths can filter with
  /// no extra query and no cross-module dependency. Deliberately not derived
  /// from the legacy `roles` column below, which is being retired.
  isHiddenAccount   Boolean        @default(false)
  locationCountry   Country?       @relation("UserLocationCountry", fields: [countryId], references: [id])
  locationRegion    Region?        @relation("UserLocationRegion", fields: [regionId], references: [id])
  locationState     State?         @relation("UserLocationState", fields: [stateId], references: [id])
  posts             Post[]

  @@index([status])
  @@index([isHiddenAccount])
  @@index([countryId])
  @@index([stateId])
  @@index([regionId])
  @@map("users")
}

/// Presentational profile — the net-new fields on top of the identity row
/// (which already holds fullName/gender/birthday/country/language). Avatar
/// and cover store the S3 object KEY; the read model resolves a URL. One row
/// per user, created with the identity in a single transaction.
model UserProfile {
  userId    String   @id @db.Uuid
  bio       String?
  avatarKey String?
  coverKey  String?
  state     String?
  city      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_profiles")
}

/// Denormalised counters shown on the profile. Written by other domains via
/// the PROFILE_SERVICE.incrementStatistic contract (gifts, follows, rooms...).
/// Hours are stored as minutes and surfaced as hours in the view.
model UserStatistics {
  userId         String   @id @db.Uuid
  followersCount Int      @default(0)
  followingCount Int      @default(0)
  friendsCount   Int      @default(0)
  visitorsCount  Int      @default(0)
  giftsSent      BigInt   @default(0)
  giftsReceived  BigInt   @default(0)
  coinsReceived  BigInt   @default(0)
  audioMinutes   Int      @default(0)
  videoMinutes   Int      @default(0)
  liveMinutes    Int      @default(0)
  exp            BigInt   @default(0)
  level          Int      @default(1)
  vipLevel       Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@map("user_statistics")
}

/// A visitor who visited a user's profile. Unique per (profileId, visitorId)
/// so unique visitors are tracked and counted accurately.
model ProfileVisitor {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @db.Uuid
  visitorId String   @db.Uuid
  visitedAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([profileId, visitorId])
  @@index([profileId])
  @@index([visitorId])
  @@map("profile_visitors")
}

/// Verified-badge state + review workflow. `verified` is the blue-check the
/// profile view exposes; status/type/documentKey drive the review request.
model UserVerification {
  userId          String             @id @db.Uuid
  verified        Boolean            @default(false)
  status          VerificationStatus @default(NONE)
  type            VerificationType?
  category        String?
  documentKey     String?
  rejectionReason String?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedBy      String?            @db.Uuid
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status])
  @@index([category])
  @@map("user_verification")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
  INACTIVE
  LOCKED
}

enum VerificationStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum VerificationType {
  IDENTITY
  CELEBRITY
  OFFICIAL
  CREATOR
}
