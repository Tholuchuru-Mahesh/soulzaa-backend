/// Enterprise Platform Event Definition
model EventDefinition {
  id                 String              @id @default(uuid()) @db.Uuid
  code               String              @unique
  name               String
  description        String?
  category           String
  banner             String?
  thumbnail          String?
  startTime          DateTime
  endTime            DateTime
  regStartTime       DateTime?
  regEndTime         DateTime?
  participationRules Json?
  eligibilityRules   Json?
  rewardDefinition   Json?
  maxParticipants    Int                 @default(1000)
  visibility         String              @default("PUBLIC")
  country            String?
  region             String?
  season             String?
  priority           Int                 @default(0)
  status             String              @default("DRAFT")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  countryId          String?             @db.Uuid
  regionId           String?             @db.Uuid
  scopeCountry       Country?            @relation("EventScopeCountry", fields: [countryId], references: [id])
  scopeRegion        Region?             @relation("EventScopeRegion", fields: [regionId], references: [id])
  participants       EventParticipant[]
  registrations      EventRegistration[]
  rewards            EventReward[]

  @@index([category])
  @@index([status])
  @@index([startTime, endTime])
  @@index([country])
  @@index([countryId])
  @@index([regionId])
  @@map("event_definitions")
}

/// User Event Registration
model EventRegistration {
  id           String          @id @default(uuid()) @db.Uuid
  eventId      String          @db.Uuid
  userId       String          @db.Uuid
  registeredAt DateTime        @default(now())
  status       String          @default("REGISTERED")
  event        EventDefinition @relation(fields: [eventId], references: [id])

  @@unique([eventId, userId])
  @@index([userId])
  @@index([status])
  @@map("event_registrations")
}

/// Active Event Participant
model EventParticipant {
  id          String          @id @default(uuid()) @db.Uuid
  eventId     String          @db.Uuid
  userId      String          @db.Uuid
  joinedAt    DateTime        @default(now())
  completedAt DateTime?
  status      String          @default("PARTICIPATING")
  score       BigInt          @default(0)
  metadata    Json?
  event       EventDefinition @relation(fields: [eventId], references: [id])

  @@unique([eventId, userId])
  @@index([eventId, status])
  @@index([userId])
  @@map("event_participants")
}

/// Event Reward Record (Dispatched via Domain Events)
model EventReward {
  id               String          @id @default(uuid()) @db.Uuid
  eventId          String          @db.Uuid
  userId           String          @db.Uuid
  rewardDefinition Json
  dispatched       Boolean         @default(false)
  dispatchedAt     DateTime?
  event            EventDefinition @relation(fields: [eventId], references: [id])

  @@index([eventId])
  @@index([userId])
  @@index([dispatched])
  @@map("event_rewards")
}

/// Event History Log
model EventHistory {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @db.Uuid
  userId    String?  @db.Uuid
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
  @@index([userId])
  @@map("event_histories")
}

/// Pre-aggregated Event Statistics
model EventStatistics {
  id                     String   @id @default(uuid()) @db.Uuid
  period                 String   @default("DAILY")
  dateKey                String
  category               String
  activeEvents           Int      @default(0)
  completedEvents        Int      @default(0)
  totalRegistrations     Int      @default(0)
  totalParticipants      Int      @default(0)
  totalRewardsDispatched Int      @default(0)
  updatedAt              DateTime @updatedAt

  @@unique([period, dateKey, category])
  @@map("event_statistics")
}

/// Operational Audit Log for Event Engine
model EventAudit {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String?  @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  details   Json?
  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([action])
  @@index([createdAt])
  @@map("event_audits")
}

/// Dynamic Event Engine Configuration
model EventConfiguration {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("event_configurations")
}
