// ============================================================
// Wealth Level (VIP) system — the ONLY VIP progression system.
//
// Progression is monthly and driven 1:1 by verified Gold Coin purchase
// credit (paid + bonus coins). See:
//   - WealthExpLedger    append-only ledger, exactly-once via idempotencyKey
//   - WealthUserProgress current month's live state (EXP + effective level)
//   - WealthMonthlyHistory / WealthMonthlyResetRun  idempotent monthly rollover
//   - WealthDowngradeConfig  Super-Admin-controlled downgrade policy
// Replaces the legacy `vip.prisma` schema entirely.
// ============================================================

/// Wealth Level tiers — a fully Super-Admin-managed ladder, not a fixed set.
/// `level` is the ordinal (0, 1, 2, ...) assigned when a tier is created and
/// doubles as its display/progression order — there is no separate ordering
/// field, since a tier's position in the ladder IS its ordinal.
model WealthLevel {
  id            String   @id @default(uuid()) @db.Uuid
  level         Int      @unique
  name          String
  expThreshold  BigInt   @default(0)
  isActive      Boolean  @default(true)
  /// Super-Admin-uploaded badge/icon art for this level (stored S3 key,
  /// resolved to a servable URL in API responses — see MediaUrlResolver).
  iconUrl       String?
  /// Super-Admin-uploaded full-screen background art for this level's VIP
  /// detail view (stored S3 key, resolved the same way as `iconUrl`). Null
  /// falls back to the client's default premium theme — never a hardcoded
  /// per-level image.
  backgroundUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  benefits   WealthLevelBenefit[]
  categories WealthBenefitCategory[]

  @@index([isActive])
  @@map("wealth_levels")
}

/// A named, admin-defined grouping of reward rows for one level — e.g.
/// "Frames", "Entry Effects", "Themes". Purely a browse-time presentation
/// layer: the app shows one tile (this category's `iconUrl` + `name`) that
/// expands to the actual reward rows inside it. The reward/claim/backpack
/// pipeline (`WealthBenefitService`) never looks at categories — it operates
/// on `WealthLevelBenefit` rows exactly as it did before this model existed.
/// `name` is free text (not an enum) so a brand-new category never needs a
/// code change.
model WealthBenefitCategory {
  id        String      @id @default(uuid()) @db.Uuid
  level     Int
  levelRef  WealthLevel @relation(fields: [level], references: [level], onDelete: Cascade)
  name      String
  /// Super-Admin-uploaded representative icon (stored S3 key, resolved like
  /// every other icon field in this schema).
  iconUrl   String?
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  benefits WealthLevelBenefit[]

  @@index([level])
  @@map("wealth_benefit_categories")
}

/// Per-level benefit configuration. Benefits are cumulative: a user at level N
/// holds every active benefit for levels 0..N. A benefit is either a grantable
/// reward (cosmeticId and/or coinAmount set — FRAME/THEME/ENTRANCE_EFFECT/
/// BADGE/GOLD_COINS types) that must be claimed into the Backpack before it
/// can be equipped, or a passive/legacy perk (neither set — every other
/// `benefitType`) that stays automatically active with no claim step, exactly
/// as before.
model WealthLevelBenefit {
  id           String                 @id @default(uuid()) @db.Uuid
  level        Int
  levelRef     WealthLevel            @relation(fields: [level], references: [level], onDelete: Cascade)
  /// Optional grouping — null means this benefit renders as its own standalone
  /// tile (today's behavior); set means it's one of the actual rewards inside
  /// a category tile the user taps to expand. `onDelete: SetNull` so deleting
  /// a category never deletes the rewards inside it, just ungroups them.
  categoryId   String?                @db.Uuid
  category     WealthBenefitCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  benefitType  WealthBenefitType
  config       Json                   @default("{}")
  /// Set only for grantable cosmetic benefit types (PROFILE_FRAME, THEME,
  /// PROFILE_THEME, ENTRANCE_ANIMATION, BADGE) — validated against the live
  /// Cosmetics catalog at admin-write time (see TreasureAdminService.resolveRewards
  /// for the pattern this mirrors).
  cosmeticId   String?                @db.Uuid
  /// Set only for GOLD_COINS benefit rows.
  coinAmount   Int?
  /// TTL in days for the granted cosmetic; null/0 = permanent.
  durationDays Int?
  isActive     Boolean                @default(true)
  /// Super-Admin-uploaded icon art for this benefit (stored S3 key, resolved
  /// to a servable URL in API responses — see MediaUrlResolver).
  iconUrl      String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  claims WealthBenefitClaim[]

  @@index([level])
  @@index([isActive])
  @@index([categoryId])
  @@map("wealth_level_benefits")
}

/// One-time claim of a grantable benefit for a user. The unique constraint is
/// the sole guard against duplicate grants (double click, retry, concurrent
/// request) — a benefit is never granted twice to the same user.
model WealthBenefitClaim {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid
  benefitId String             @db.Uuid
  benefit   WealthLevelBenefit @relation(fields: [benefitId], references: [id], onDelete: Cascade)
  claimedAt DateTime           @default(now())

  @@unique([userId, benefitId])
  @@index([userId])
  @@map("wealth_benefit_claims")
}

/// Current month's live state — one row per user. `currentLevel` is the
/// *effective* level: max(downgrade floor for this month, level derived from
/// currentExp). Reset to a new floor + currentExp=0 at each monthly rollover.
model WealthUserProgress {
  userId       String   @id @db.Uuid
  currentExp   BigInt   @default(0)
  currentLevel Int      @default(0)
  /// Month this progress belongs to, "YYYY-MM".
  periodKey    String
  updatedAt    DateTime @updatedAt

  @@index([periodKey])
  @@index([currentLevel])
  @@map("wealth_user_progress")
}

/// Append-only, immutable EXP ledger. The ONLY way EXP ever changes.
/// `idempotencyKey` is the exactly-once guard for purchase-driven awards.
model WealthExpLedger {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @db.Uuid
  direction      WealthExpDirection
  amount         BigInt
  sourceType     WealthExpSourceType
  /// The purchase/order id (or original ledger entry id for a REVERSAL).
  sourceRef      String
  idempotencyKey String              @unique
  /// Month this EXP is attributed to, "YYYY-MM".
  periodKey      String
  metadata       Json?
  createdAt      DateTime            @default(now())

  @@index([userId, createdAt])
  @@index([periodKey])
  @@index([sourceRef])
  @@map("wealth_exp_ledger")
}

/// End-of-month snapshot per user. The unique constraint doubles as the
/// per-user idempotency guard for the monthly reset job.
model WealthMonthlyHistory {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  periodKey         String
  startingLevel     Int
  finalExp          BigInt
  finalLevel        Int
  downgradedToLevel Int?
  createdAt         DateTime @default(now())

  @@unique([userId, periodKey])
  @@index([periodKey])
  @@map("wealth_monthly_history")
}

/// Batch-level idempotency/observability for the monthly reset job — a re-run
/// for an already-COMPLETED periodKey is a no-op.
model WealthMonthlyResetRun {
  id             String               @id @default(uuid()) @db.Uuid
  periodKey      String               @unique
  status         WealthResetRunStatus @default(RUNNING)
  startedAt      DateTime             @default(now())
  completedAt    DateTime?
  usersProcessed Int                  @default(0)
  createdAt      DateTime             @default(now())

  @@map("wealth_monthly_reset_runs")
}

/// Super-Admin-controlled downgrade policy. Multiple rows support scheduling a
/// future policy change; the active row is the one with the latest
/// `effectiveFrom` <= now that hasn't passed `effectiveTo`.
model WealthDowngradeConfig {
  id                 String                @id @default(uuid()) @db.Uuid
  enabled            Boolean               @default(true)
  maxDowngradeLevels Int                   @default(1)
  minLevel           Int                   @default(0)
  policy             WealthDowngradePolicy @default(STANDARD)
  effectiveFrom      DateTime              @default(now())
  effectiveTo        DateTime?
  updatedBy          String?               @db.Uuid
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([effectiveFrom])
  @@map("wealth_downgrade_config")
}

/// Generic key/value configuration for the Wealth Level module.
model WealthConfiguration {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  updatedBy String?  @db.Uuid
  updatedAt DateTime @updatedAt

  @@map("wealth_configuration")
}

/// Operational audit trail for every Super Admin configuration change
/// (levels, benefits, downgrade policy, general configuration).
model WealthAudit {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @db.Uuid
  action     String
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("wealth_audit")
}

enum WealthBenefitType {
  BADGE
  PROFILE_FRAME
  AVATAR_EFFECT
  AVATAR_RING
  CHAT_BUBBLE
  CHAT_EFFECT
  CHAT_HIGHLIGHT
  ROOM_EFFECT
  GIFT_EFFECT
  THEME
  PROFILE_THEME
  ANIMATION
  ENTRANCE_ANIMATION
  PROFILE_STYLE
  THEME_SLOTS
  CUSTOM_GIFT_CREATOR
  VISITOR_HISTORY
  STICKER_PACK
  ANONYMOUS_ENTRY
  ANONYMOUS_GIFT
  MIC_PRIORITY
  VOICE_EFFECT
  SUPPORT_PRIORITY
  PROFILE_SHOWCASE
  EVENT_ACCESS
  VIP_HALL
  RELATIONSHIP_MANAGER
  FEATURE_ACCESS
  RECOGNITION
  OTHER
  /// Claimable Gold Coin grant — the only benefit type with no cosmetic
  /// backing (see WealthLevelBenefit.coinAmount).
  GOLD_COINS
}

enum WealthExpDirection {
  AWARD
  REVERSAL
}

enum WealthExpSourceType {
  GOLD_COIN_PURCHASE
  PURCHASE_REVERSAL
  ADMIN_ADJUSTMENT
}

enum WealthResetRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum WealthDowngradePolicy {
  STANDARD
}
