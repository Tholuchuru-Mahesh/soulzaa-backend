/// A per-room member mute (independent of seat occupancy). PERMANENT + null
/// `expiresAt` ⇒ "mute until manually removed". One ACTIVE mute per user/room
/// (service-enforced under a lock). Redis mirrors the active set for the fast
/// join-time gate in later phases.
model VideoRoomMute {
  id          String                      @id @default(uuid()) @db.Uuid
  roomId      String                      @db.Uuid
  userId      String                      @db.Uuid
  moderatorId String                      @db.Uuid
  type        VideoRoomModerationMuteType
  reason      String?
  expiresAt   DateTime?
  status      VideoRoomModerationStatus   @default(ACTIVE)
  liftedBy    String?                     @db.Uuid
  liftedAt    DateTime?
  createdBy   String?                     @db.Uuid
  updatedBy   String?                     @db.Uuid
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  @@index([roomId, status])
  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("video_room_mutes")
}

/// A per-room block — the durable "blocklist" a room's owner/admins manage. A
/// blocked user is removed from the room AND barred from rejoining until a
/// moderator restores them (status → LIFTED). Unlike a ban there is no expiry:
/// it lasts until lifted. At most one ACTIVE block per (roomId,userId),
/// service-enforced under a lock. Redis mirrors the active set for the join gate.
model VideoRoomBlock {
  id          String                    @id @default(uuid()) @db.Uuid
  roomId      String                    @db.Uuid
  userId      String                    @db.Uuid
  moderatorId String                    @db.Uuid
  type        VideoRoomBlockType        @default(PERMANENT)
  reason      String?
  expiresAt   DateTime?
  status      VideoRoomModerationStatus @default(ACTIVE)
  liftedBy    String?                   @db.Uuid
  liftedAt    DateTime?
  createdBy   String?                   @db.Uuid
  updatedBy   String?                   @db.Uuid
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([roomId, status])
  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("video_room_blocks")
}

/// A per-room kick — the durable "Kick List" a room's owner/admins manage. A
/// kicked user is removed from the room AND barred from rejoining until a
/// moderator restores them (status → LIFTED).
model VideoRoomKick {
  id          String                    @id @default(uuid()) @db.Uuid
  roomId      String                    @db.Uuid
  userId      String                    @db.Uuid
  moderatorId String                    @db.Uuid
  reason      String?
  status      VideoRoomModerationStatus @default(ACTIVE)
  liftedBy    String?                   @db.Uuid
  liftedAt    DateTime?
  createdBy   String?                   @db.Uuid
  updatedBy   String?                   @db.Uuid
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([roomId, status])
  @@index([userId, status])
  @@map("video_room_kicks")
}

/// Append-only immutable audit of every moderator action (mute/unmute/block/
/// unblock/kick/warn/role-grant/announcement). Write-once — the system of record
/// for moderation review and compliance.
model VideoRoomModerationAction {
  id           String                        @id @default(uuid()) @db.Uuid
  roomId       String                        @db.Uuid
  moderatorId  String?                       @db.Uuid
  targetUserId String?                       @db.Uuid
  action       VideoRoomModerationActionType
  reason       String?
  metadata     Json?
  createdAt    DateTime                      @default(now())

  @@index([roomId])
  @@index([action])
  @@index([targetUserId])
  @@map("video_room_moderation_actions")
}

/// A member-filed report against a user (and, optionally, a specific chat
/// message) within a room. PENDING until a moderator reviews it; REVIEWED/
/// DISMISSED/ACTIONED record the outcome. No DB foreign keys — reference
/// rooms/users/messages by id (@@index).
model VideoRoomReport {
  id               String                @id @default(uuid()) @db.Uuid
  roomId           String                @db.Uuid
  reporterId       String                @db.Uuid
  targetUserId     String                @db.Uuid
  messageId        String?               @db.Uuid
  reason           VideoRoomReportReason
  description      String?
  status           VideoRoomReportStatus @default(PENDING)
  assigneeId       String?               @db.Uuid
  assignedAt       DateTime?
  reviewedBy       String?               @db.Uuid
  reviewedAt       DateTime?
  resolutionAction String?
  moderatorNotes   String?
  createdBy        String?               @db.Uuid
  updatedBy        String?               @db.Uuid
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([roomId, status])
  @@index([assigneeId, status])
  @@index([targetUserId])
  @@index([reporterId])
  @@map("video_room_reports")
}

/// A moderator-issued warning — recorded against a user/room independent of
/// the append-only moderation action trail so warnings can be queried and
/// (later) surfaced to the user on their own. No DB foreign keys — reference
/// rooms/users by id (@@index).
model VideoRoomWarning {
  id          String   @id @default(uuid()) @db.Uuid
  roomId      String   @db.Uuid
  userId      String   @db.Uuid
  moderatorId String   @db.Uuid
  reason      String
  metadata    Json?
  createdBy   String?  @db.Uuid
  updatedBy   String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([roomId, userId])
  @@index([userId])
  @@map("video_room_warnings")
}

/// TEMPORARY (has an expiry) vs PERMANENT (until manually lifted).
enum VideoRoomBlockType {
  TEMPORARY
  PERMANENT
}

/// TEMPORARY (has an expiry) vs PERMANENT (until manually lifted).
enum VideoRoomModerationMuteType {
  TEMPORARY
  PERMANENT
}

/// Lifecycle of a mute/block: ACTIVE until lifted (manually) or expired (TTL).
enum VideoRoomModerationStatus {
  ACTIVE
  LIFTED
  EXPIRED
}

/// Actions recorded in the append-only video_room_moderation_actions audit trail.
/// No BAN_* actions — the Video Room has no ban feature.
enum VideoRoomModerationActionType {
  MUTE_TEMPORARY
  MUTE_PERMANENT
  UNMUTE
  BLOCK
  UNBLOCK
  KICK
  UNKICK
  WARN
  ROLE_GRANTED
  ROLE_REVOKED
  ANNOUNCEMENT_POSTED
  ANNOUNCEMENT_REMOVED
  FORCE_DISCONNECT
  REPORT_REVIEWED
  ROOM_MUTED
  ROOM_UNMUTED
  AUTO_MUTED
  AUTO_KICKED
  AUTO_FLAGGED
}

/// Why a report was filed.
enum VideoRoomReportReason {
  USER
  MESSAGE
  SPAM
  HARASSMENT
  ABUSE
  FAKE_ACCOUNT
  HATE_SPEECH
  BULLYING
  THREATS
  SEXUAL_CONTENT
  INAPPROPRIATE_CONTENT
  OTHER
}

/// Triage lifecycle of a VideoRoomReport.
enum VideoRoomReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTIONED
}
