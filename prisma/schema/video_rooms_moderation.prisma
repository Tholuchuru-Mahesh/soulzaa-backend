// ============================================================
// Video Rooms — VR-1: Moderation (mutes, blocks, and the
// append-only moderation audit trail). Owned by the "video_rooms"
// module. Mirrors the Audio-Room AR-3 moderation model, MINUS bans
// (room ban is intentionally out of scope for the Video Room —
// block covers the "bar from this room" need). No enforcement logic
// here; live enforcement (active mute/block sets) is cached in Redis
// in later phases. These tables are the durable record. No DB
// foreign keys — reference rooms/users by id (@@index).
// ============================================================

/// TEMPORARY (has an expiry) vs PERMANENT (until manually lifted).
enum VideoRoomModerationMuteType {
  TEMPORARY
  PERMANENT
}

/// Lifecycle of a mute/block: ACTIVE until lifted (manually) or expired (TTL).
enum VideoRoomModerationStatus {
  ACTIVE
  LIFTED
  EXPIRED
}

/// Actions recorded in the append-only video_room_moderation_actions audit trail.
/// No BAN_* actions — the Video Room has no ban feature.
enum VideoRoomModerationActionType {
  MUTE_TEMPORARY
  MUTE_PERMANENT
  UNMUTE
  BLOCK
  UNBLOCK
  KICK
  WARN
  ROLE_GRANTED
  ROLE_REVOKED
  ANNOUNCEMENT_POSTED
  ANNOUNCEMENT_REMOVED
}

/// A per-room member mute (independent of seat occupancy). PERMANENT + null
/// `expiresAt` ⇒ "mute until manually removed". One ACTIVE mute per user/room
/// (service-enforced under a lock). Redis mirrors the active set for the fast
/// join-time gate in later phases.
model VideoRoomMute {
  id          String                      @id @default(uuid()) @db.Uuid
  roomId      String                      @db.Uuid
  userId      String                      @db.Uuid
  moderatorId String                      @db.Uuid
  type        VideoRoomModerationMuteType
  reason      String?
  expiresAt   DateTime?
  status      VideoRoomModerationStatus   @default(ACTIVE)
  liftedBy    String?                     @db.Uuid
  liftedAt    DateTime?

  // ---- Audit ----
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId, status])
  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("video_room_mutes")
}

/// A per-room block — the durable "blocklist" a room's owner/admins manage. A
/// blocked user is removed from the room AND barred from rejoining until a
/// moderator restores them (status → LIFTED). Unlike a ban there is no expiry:
/// it lasts until lifted. At most one ACTIVE block per (roomId,userId),
/// service-enforced under a lock. Redis mirrors the active set for the join gate.
model VideoRoomBlock {
  id          String                    @id @default(uuid()) @db.Uuid
  roomId      String                    @db.Uuid
  userId      String                    @db.Uuid
  moderatorId String                    @db.Uuid
  reason      String?
  status      VideoRoomModerationStatus @default(ACTIVE)
  liftedBy    String?                   @db.Uuid
  liftedAt    DateTime?

  // ---- Audit ----
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId, status])
  @@index([userId, status])
  @@map("video_room_blocks")
}

/// Append-only immutable audit of every moderator action (mute/unmute/block/
/// unblock/kick/warn/role-grant/announcement). Write-once — the system of record
/// for moderation review and compliance.
model VideoRoomModerationAction {
  id           String                        @id @default(uuid()) @db.Uuid
  roomId       String                        @db.Uuid
  moderatorId  String?                       @db.Uuid
  targetUserId String?                       @db.Uuid
  action       VideoRoomModerationActionType
  reason       String?
  metadata     Json?
  createdAt    DateTime                      @default(now())

  @@index([roomId])
  @@index([action])
  @@index([targetUserId])
  @@map("video_room_moderation_actions")
}
