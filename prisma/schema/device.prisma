/// A physical device an account has logged in from. Upserted by
/// (userId, deviceIdentifier) so repeated logins are idempotent.
/// `trusted`/`verified` are fast flags; the trust ledger + audit trail
/// live in trusted_devices / device_history.
model UserDevice {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String         @db.Uuid
  deviceIdentifier String
  platform         DevicePlatform
  pushToken        String?
  /// PushKit VoIP token (iOS only) — the *only* push type Apple delivers to a
  /// force-quit app, and the one an incoming call's push must use to raise a
  /// real CallKit ring screen when this device is backgrounded, locked, or
  /// killed. Distinct from `pushToken` (APNs "alert" token, via FCM) because
  /// iOS issues them separately and they are delivered through entirely
  /// different transports — see `ApnsVoipPushProvider`.
  voipPushToken    String?
  lastActiveAt     DateTime       @default(now()) @map("lastSeenAt")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  trusted          Boolean        @default(false)
  trustedAt        DateTime?
  appVersion       String?
  country          String?
  deletedAt        DateTime?
  deviceName       String?
  deviceType       String?
  ipAddress        String?
  osVersion        String?
  verified         Boolean        @default(false)
  verifiedAt       DateTime?

  @@unique([userId, deviceIdentifier])
  @@index([userId])
  @@map("user_devices")
}

/// Normalised trust ledger — the source of truth for "which devices a
/// user has trusted", with grant metadata. Kept in sync with the
/// denormalised user_devices.trusted flag (fast reads for session checks).
model TrustedDevice {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  deviceId    String    @unique @db.Uuid
  trustedByIp String?
  trustedAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@index([userId])
  @@map("trusted_devices")
}

/// Append-only audit of every device lifecycle event (registration,
/// verification, trust changes, suspicious logins, removal).
model DeviceHistory {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @db.Uuid
  deviceId  String?         @db.Uuid
  event     DeviceEventType
  ip        String?
  country   String?
  userAgent String?
  metadata  Json?
  createdAt DateTime        @default(now())

  @@index([userId])
  @@index([deviceId])
  @@map("device_history")
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

enum DeviceEventType {
  REGISTERED
  VERIFIED
  REMOVED
  TRUSTED
  UNTRUSTED
  SUSPICIOUS_LOGIN
  PUSH_TOKEN_UPDATED
  RENAMED
  CHANGE_REQUESTED
  CHANGE_APPROVED
  CHANGE_REJECTED
}

/// Approved IP addresses / CIDR ranges for staff/moderator accounts.
model StaffAllowedIp {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  cidr      String
  label     String?
  addedBy   String    @db.Uuid
  addedAt   DateTime  @default(now())
  removedBy String?   @db.Uuid
  removedAt DateTime?
  isActive  Boolean   @default(true)

  @@index([userId, isActive])
  @@map("staff_allowed_ips")
}
