// ============================================================
// Soulzaa — Prisma base schema
// Multi-file schema (prismaSchemaFolder): datasource + generator
// live here; each domain owns its own <module>.prisma file in
// this folder. One database, one migration history, boundaries
// expressed by file ownership.
// ============================================================

// No custom `output`. It previously pointed at `../../node_modules/.prisma/client`,
// which is the wrong directory under pnpm: `@prisma/client` is a symlink into
// node_modules/.pnpm, and it loads `.prisma/client` from beside its own real
// location there — not from the top-level node_modules. `prisma generate` was
// therefore writing a fresh client that TypeScript never read, leaving compiles
// against a stale enum (a newly added PlatformRole such as CREATOR was missing
// from every consumer). The default output is pnpm-aware; leave it alone.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PlatformRole {
  SUPER_ADMIN
  ADMIN
  COUNTRY_MANAGER
  OFFICIAL
  MODERATOR
  BUSINESS_DEVELOPMENT
  AGENCY
  COIN_SELLER
  HOST
  USER
  CREATOR
}

enum CurrencyType {
  GOLD
  FREE
}
