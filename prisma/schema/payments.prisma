/// Purchasable Soul Coin Package
model CoinPackage {
  id              String          @id @default(uuid()) @db.Uuid
  code            String          @unique
  name            String
  coins           BigInt
  bonusCoins      BigInt          @default(0)
  priceAmount     Decimal         @db.Decimal(12, 2)
  currency        String          @default("USD")
  country         String?         @default("GLOBAL")
  platform        String?         @default("ALL")
  isActive        Boolean         @default(true)
  sortOrder       Int             @default(0)
  createdBy       String?         @db.Uuid
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  /// Google Play in-app product ID. Play requires lowercase `[a-z0-9_.]`, so this
  /// cannot reuse `code` (`IN_GOLD_100`). Null means the package is not sellable
  /// on Android and the client hides it.
  googleProductId String?         @unique
  /// App Store product ID. Null until the iOS spec lands.
  appleProductId  String?         @unique
  orders          PurchaseOrder[]

  @@index([isActive])
  @@index([platform])
  @@map("coin_packages")
}

/// Purchase Order Lifecycle Entity
model PurchaseOrder {
  id                  String              @id @default(uuid()) @db.Uuid
  orderNumber         String              @unique
  userId              String              @db.Uuid
  packageId           String              @db.Uuid
  provider            PaymentProvider
  coinsAmount         BigInt
  bonusCoinsAmount    BigInt              @default(0)
  totalCoins          BigInt
  priceAmount         Decimal             @db.Decimal(12, 2)
  currency            String
  status              PurchaseOrderStatus @default(CREATED)
  providerTxnRef      String?
  walletTransactionId String?             @db.Uuid
  idempotencyKey      String              @unique
  metadata            Json?
  expiresAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  /// When Google Play acknowledged the consume for this order's purchase token.
  /// Null on a COMPLETED Google Play order means the consume never landed: the
  /// SKU stays owned-and-unconsumed in Play, so the user can never re-buy that
  /// tier and `restorePurchases()` redelivers it on every launch.
  /// `PurchaseReconciliationService.retryPendingConsumes` sweeps exactly this set.
  consumedAt          DateTime?
  receipts            PaymentReceipt[]
  package             CoinPackage         @relation(fields: [packageId], references: [id])

  @@index([userId, createdAt])
  @@index([status])
  @@index([provider, providerTxnRef])
  @@index([status, provider, consumedAt])
  @@map("purchase_orders")
}

/// Payment Receipt verification record for IAP and Gateway Webhooks
model PaymentReceipt {
  id                 String          @id @default(uuid()) @db.Uuid
  purchaseOrderId    String          @db.Uuid
  provider           PaymentProvider
  receiptData        String
  signature          String?
  providerTxnId      String?         @unique
  isVerified         Boolean         @default(false)
  verificationResult Json?
  verifiedAt         DateTime?
  createdAt          DateTime        @default(now())
  purchaseOrder      PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@map("payment_receipts")
}

/// Operational Audit Log for Purchase and Verification Events
model PurchaseAudit {
  id              String   @id @default(uuid()) @db.Uuid
  purchaseOrderId String?  @db.Uuid
  action          String
  details         Json?
  actorId         String?  @db.Uuid
  createdAt       DateTime @default(now())

  @@index([purchaseOrderId])
  @@index([createdAt])
  @@map("purchase_audits")
}

enum PaymentProvider {
  GOOGLE_PLAY
  APPLE_IAP
  RAZORPAY
  STRIPE
  MOCK_GATEWAY
}

enum PurchaseOrderStatus {
  CREATED
  PENDING_PAYMENT
  VERIFICATION_PENDING
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
}
