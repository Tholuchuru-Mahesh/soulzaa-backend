/// One row per issued refresh token (rotation-enabled). The refresh JWT
/// is stored only as a SHA-256 hash. `replacedBySessionId` chains
/// rotations so a replayed (already-rotated) token triggers reuse
/// detection. `id` is the `sid` claim embedded in access/refresh tokens.
model UserSession {
  id                  String          @id @default(uuid()) @db.Uuid
  userId              String          @db.Uuid
  deviceId            String?         @db.Uuid
  refreshTokenHash    String
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedBySessionId String?         @db.Uuid
  createdByIp         String?
  userAgent           String?
  lastActivityAt      DateTime        @default(now()) @map("lastUsedAt")
  createdAt           DateTime        @default(now())
  platform            DevicePlatform?

  @@index([userId])
  @@index([refreshTokenHash])
  @@map("user_sessions")
}

/// Append-only audit of every session lifecycle event. Backs security
/// review (hijack detection, admin force-logout) and device history.
model SessionHistory {
  id         String           @id @default(uuid()) @db.Uuid
  sessionId  String?          @db.Uuid
  userId     String           @db.Uuid
  event      SessionEventType
  ip         String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime         @default(now())
  browser    String?
  country    String?
  deviceType String?
  os         String?

  @@index([userId])
  @@index([sessionId])
  @@map("session_history")
}

enum SessionEventType {
  CREATED
  REFRESHED
  REVOKED
  EXPIRED
  LOGGED_OUT
  HIJACK_DETECTED
  ADMIN_LOGOUT
  CONCURRENT_EVICTED
  FAILED_LOGIN
}
