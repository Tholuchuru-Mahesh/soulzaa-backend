/// A room's active appearance. `themeCosmeticId` is the applied THEME/background;
/// `decorationCosmeticIds` are the applied DECORATION cosmetics (parallel to
/// `decorationNames` for display). Reset clears all fields.
model RoomAppearance {
  roomId                String   @id @db.Uuid
  themeCosmeticId       String?  @db.Uuid
  themeName             String?
  decorationCosmeticIds String[] @db.Uuid
  decorationNames       String[]
  updatedBy             String?  @db.Uuid
  updatedAt             DateTime @updatedAt

  @@map("room_appearance")
}
