/// A single in-app notification for `userId`, optionally caused by
/// `actorId` (the other user) and pointing at an entity (room/request/
/// invitation). `data` carries denormalised display fields resolved at
/// creation time. `readAt` null = unread.
model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  type       NotificationType
  actorId    String?          @db.Uuid
  entityType String?
  entityId   String?          @db.Uuid
  data       Json?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

/// Per-user notification delivery toggles, honoured by the push pipeline before a
/// token is ever resolved (`PushProcessor`). One row per user, created on first
/// read with everything enabled — an absent row means "default on", never "off",
/// so a user who has never opened Settings still gets their calls.
///
/// Every boolean maps to exactly one `PushCategory` (see device/push.categories).
/// The one category with no switch here is SECURITY: a suspicious-login alert is
/// not a notification the account owner gets to opt out of on the device that may
/// be the attacker's.
model NotificationPreference {
  userId             String    @id @db.Uuid
  /// Master switch. Off = no push of any category (except SECURITY).
  pushEnabled        Boolean   @default(true)
  friendEvents       Boolean   @default(true)
  followEvents       Boolean   @default(true)
  inviteEvents       Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  messageEvents      Boolean   @default(true)
  callEvents         Boolean   @default(true)
  giftEvents         Boolean   @default(true)
  systemEvents       Boolean   @default(true)
  /// Drives which Android channel the push is delivered on (channels own their
  /// sound/vibration on Android and are immutable once created, so the *server*
  /// selects the channel — flipping a client-side flag could not change an
  /// already-registered channel's behaviour).
  sound              Boolean   @default(true)
  vibration          Boolean   @default(true)
  /// Off = the push body is replaced with a generic string before it leaves the
  /// server. The preview never reaches the device, which is the only version of
  /// "hide preview" that is actually private — hiding it client-side still ships
  /// the message text to a lock screen.
  showPreview        Boolean   @default(true)
  /// "Mute all until" — a snooze, distinct from `pushEnabled: false`, which is a
  /// permanent opt-out. Null = not snoozed.
  mutedUntil         DateTime?
  roomEvents         Boolean   @default(true)
  seatEvents         Boolean   @default(true)
  treasureEvents     Boolean   @default(true)
  pkEvents           Boolean   @default(true)
  announcementEvents Boolean   @default(true)
  /// Recharge, refund, withdrawal decision, admin balance adjustment.
  walletEvents       Boolean   @default(true)
  /// Match found and game settled. Lobby churn is never pushed.
  gameEvents         Boolean   @default(true)
  vipEvents          Boolean   @default(true)
  /// Membership changes. Family invitations are gated by `inviteEvents`.
  familyEvents       Boolean   @default(true)

  @@map("notification_preferences")
}

/// Enterprise Notification Record
model EnterpriseNotification {
  id          String                @id @default(uuid()) @db.Uuid
  recipientId String?               @db.Uuid
  type        String
  priority    String                @default("NORMAL")
  title       String?
  body        String?
  scheduledAt DateTime?
  status      String                @default("PENDING")
  retryCount  Int                   @default(0)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  histories   NotificationHistory[]
  inboxes     NotificationInbox[]

  @@index([recipientId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("enterprise_notifications")
}

/// Notification Template Definition
model NotificationTemplate {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique
  titleTemplate String
  bodyTemplate  String
  locale        String   @default("en")
  variables     Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("notification_templates")
}

/// User Notification Preference
model EnterpriseNotificationPreference {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  type      String
  channel   String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([userId, type, channel])
  @@map("enterprise_notification_preferences")
}

/// In-App Inbox Notification Instance
model NotificationInbox {
  id             String                 @id @default(uuid()) @db.Uuid
  notificationId String                 @db.Uuid
  recipientId    String                 @db.Uuid
  title          String
  body           String
  read           Boolean                @default(false)
  readAt         DateTime?
  deleted        Boolean                @default(false)
  deletedAt      DateTime?
  createdAt      DateTime               @default(now())
  notification   EnterpriseNotification @relation(fields: [notificationId], references: [id])

  @@index([recipientId])
  @@index([read])
  @@index([deleted])
  @@map("notification_inboxes")
}

/// Dispatch/Delivery Channels History Log
model NotificationHistory {
  id             String                 @id @default(uuid()) @db.Uuid
  notificationId String                 @db.Uuid
  recipientId    String?                @db.Uuid
  channel        String
  status         String
  errorMessage   String?
  dispatchedAt   DateTime               @default(now())
  notification   EnterpriseNotification @relation(fields: [notificationId], references: [id])

  @@index([notificationId])
  @@index([recipientId])
  @@map("notification_histories")
}

/// Pre-Aggregated Notification Statistics
model NotificationStatistics {
  id          String   @id @default(uuid()) @db.Uuid
  period      String   @default("DAILY")
  dateKey     String
  channel     String
  sentCount   Int      @default(0)
  readCount   Int      @default(0)
  failedCount Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([period, dateKey, channel])
  @@map("notification_statistics")
}

/// Audit Log for Notification Center Operations
model NotificationAudit {
  id             String   @id @default(uuid()) @db.Uuid
  notificationId String?  @db.Uuid
  actorId        String?  @db.Uuid
  action         String
  details        Json?
  createdAt      DateTime @default(now())

  @@index([notificationId])
  @@index([action])
  @@index([createdAt])
  @@map("notification_audits")
}

/// Dynamic Configuration Store
model NotificationConfiguration {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("notification_configurations")
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  NEW_FOLLOWER
  ROOM_INVITE
  GAME_INVITE
  FAMILY_INVITE
  PK_INVITE
  EVENT_INVITE
  NEW_MESSAGE
  CHAT_REQUEST
  /// An inbound call that went unanswered. Durable on purpose: a missed call is
  /// something the user has to be able to come back to, not a durable banner they may
  /// have swiped away while driving.
  MISSED_CALL
  /// Someone sent this user a gift. Durable because it is worth money — a reward
  /// the recipient can only see if they happened to be looking is not a reward.
  GIFT_RECEIVED
  ROOM_STARTED
  ROOM_CLOSED
  ROOM_LOCKED
  ROOM_UNLOCKED
  SEAT_INVITE
  SEAT_APPROVED
  SEAT_REJECTED
  VIEWER_PROMOTED
  VIEWER_DEMOTED
  TREASURE_UNLOCKED
  TREASURE_REWARD
  PK_ACCEPTED
  PK_REJECTED
  PK_STARTED
  PK_ENDED
  PK_WINNER
  ANNOUNCEMENT
  MENTION
  SYSTEM
  /// Coins bought. GIFT_RECEIVE movements are excluded from the wallet
  /// producer — GIFT_RECEIVED already covers those, and notifying on both
  /// would double-notify every gift on the platform.
  RECHARGE_SUCCESS
  WITHDRAWAL_APPROVED
  WITHDRAWAL_REJECTED
  REFUND_PROCESSED
  /// An unexplained credit (admin adjustment, event/attendance reward).
  COINS_RECEIVED
  /// An unexplained debit. Admin adjustments only — a user spending their own
  /// coins does not need to be told they spent their own coins.
  COINS_DEDUCTED
  GAME_MATCH_FOUND
  GAME_STARTED
  GAME_WON
  GAME_LOST
  GAME_OPPONENT_LEFT
  VIP_ACTIVATED
  VIP_RENEWED
  VIP_EXPIRING
  VIP_EXPIRED
  FAMILY_MEMBER_JOINED
  FAMILY_MEMBER_LEFT
  FAMILY_REMOVED
  SECURITY_NEW_LOGIN
  SECURITY_PASSWORD_CHANGED
  ROLE_REQUEST_UPDATE
  ROLE_GRANTED
  MODERATOR_SHIFT_STARTING
  MODERATOR_SHIFT_ENDING
  MODERATOR_TASK_ASSIGNED
  MODERATOR_TASK_DUE_SOON
  MODERATOR_WARNING_ISSUED
  MODERATOR_HIGH_PRIORITY_REPORT
  MODERATOR_REPORT_ASSIGNED
  MODERATOR_EMERGENCY_REQUEST
  MODERATOR_POLICY_UPDATE
  MODERATOR_OFFICIAL_MESSAGE
  MODERATOR_MANAGER_INSTRUCTION
  MODERATOR_SYSTEM_ANNOUNCEMENT
  /// A Moderator escalated a critical violation. Sent to whichever
  /// Official/Country Manager/Admin the severity routes to — never to
  /// moderators themselves (see MODERATOR_EMERGENCY_REQUEST for that
  /// direction).
  MODERATION_CASE_ESCALATED
  /// Support staff replied on a ticket the user raised. Durable: the reply is
  /// the answer to a question the user asked, so it must survive being missed.
  SUPPORT_TICKET_REPLY
  /// The user's ticket reached a terminal state (RESOLVED or CLOSED).
  SUPPORT_TICKET_RESOLVED
  /// The submitter replied on a ticket — routed to the assigned Official, or to
  /// the escalation Admin once one is set.
  SUPPORT_TICKET_USER_REPLY
  /// A Moderator's device-change request needs action — either self-filed or
  /// auto-filed by a blocked login from an unrecognized device. Sent to every
  /// Admin/Super Admin; only they can give final approval.
  MODERATOR_DEVICE_CHANGE_REQUESTED
}
