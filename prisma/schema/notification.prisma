// ============================================================
// Notification — notifications, notification preferences.
// Owned by the "notification" module. No cross-module relations —
// reference other domains by id and coordinate via the event bus.
// The write path is driven by a listener subscribing to domain events
// (e.g. SOCIAL_EVENTS.*); producers never touch these tables.
// ============================================================

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  NEW_FOLLOWER
  ROOM_INVITE
  GAME_INVITE
  FAMILY_INVITE
  PK_INVITE
  EVENT_INVITE
  NEW_MESSAGE
  CHAT_REQUEST
  /// An inbound call that went unanswered. Durable on purpose: a missed call is
  /// something the user has to be able to come back to, not a durable banner they may
  /// have swiped away while driving.
  MISSED_CALL
  /// Someone sent this user a gift. Durable because it is worth money — a reward
  /// the recipient can only see if they happened to be looking is not a reward.
  GIFT_RECEIVED
}

/// A single in-app notification for `userId`, optionally caused by
/// `actorId` (the other user) and pointing at an entity (room/request/
/// invitation). `data` carries denormalised display fields resolved at
/// creation time. `readAt` null = unread.
model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  type       NotificationType
  actorId    String?          @db.Uuid
  entityType String?
  entityId   String?          @db.Uuid
  data       Json?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

/// Per-user notification delivery toggles, honoured by the push pipeline before a
/// token is ever resolved (`PushProcessor`). One row per user, created on first
/// read with everything enabled — an absent row means "default on", never "off",
/// so a user who has never opened Settings still gets their calls.
///
/// Every boolean maps to exactly one `PushCategory` (see device/push.categories).
/// The one category with no switch here is SECURITY: a suspicious-login alert is
/// not a notification the account owner gets to opt out of on the device that may
/// be the attacker's.
model NotificationPreference {
  userId String @id @db.Uuid

  /// Master switch. Off = no push of any category (except SECURITY).
  pushEnabled Boolean @default(true)

  // ---- Per-category switches ----
  messageEvents Boolean @default(true)
  callEvents    Boolean @default(true)
  friendEvents  Boolean @default(true)
  followEvents  Boolean @default(true)
  inviteEvents  Boolean @default(true)
  giftEvents    Boolean @default(true)
  systemEvents  Boolean @default(true)

  // ---- Presentation ----
  /// Drives which Android channel the push is delivered on (channels own their
  /// sound/vibration on Android and are immutable once created, so the *server*
  /// selects the channel — flipping a client-side flag could not change an
  /// already-registered channel's behaviour).
  sound     Boolean @default(true)
  vibration Boolean @default(true)

  /// Off = the push body is replaced with a generic string before it leaves the
  /// server. The preview never reaches the device, which is the only version of
  /// "hide preview" that is actually private — hiding it client-side still ships
  /// the message text to a lock screen.
  showPreview Boolean @default(true)

  /// "Mute all until" — a snooze, distinct from `pushEnabled: false`, which is a
  /// permanent opt-out. Null = not snoozed.
  mutedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_preferences")
}

// ============================================================
// Phase 19: Enterprise Notification Center Models
// ============================================================

/// Enterprise Notification Record
model EnterpriseNotification {
  id          String    @id @default(uuid()) @db.Uuid
  recipientId String?   @db.Uuid // Null indicates a global announcement or broadcast
  type        String    // WALLET | GIFT | VIP | LEVEL_UP | ACHIEVEMENT_UNLOCK | BADGE_UNLOCK | RANKING_PROMOTION | EVENT_REMINDER | TASK_COMPLETION | MISSION_COMPLETION | REFERRAL_QUALIFIED | WITHDRAWAL_UPDATES | FAMILY_UPDATES | MODERATION_ALERT | ANNOUNCEMENT | SYSTEM
  priority    String    @default("NORMAL") // LOW | NORMAL | HIGH | CRITICAL
  title       String?
  body        String?
  scheduledAt DateTime?
  status      String    @default("PENDING") // PENDING | DISPATCHED | FAILED | CANCELLED
  retryCount  Int       @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  inboxes     NotificationInbox[]
  histories   NotificationHistory[]

  @@index([recipientId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("enterprise_notifications")
}

/// Notification Template Definition
model NotificationTemplate {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique
  titleTemplate String
  bodyTemplate  String
  locale        String   @default("en")
  variables     Json?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("notification_templates")
}

/// User Notification Preference
model EnterpriseNotificationPreference {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  type      String   // WALLET | GIFT | VIP | etc.
  channel   String   // IN_APP | PUSH | WEBSOCKET | EMAIL | SMS
  enabled   Boolean  @default(true)

  updatedAt DateTime @updatedAt

  @@unique([userId, type, channel])
  @@map("enterprise_notification_preferences")
}

/// In-App Inbox Notification Instance
model NotificationInbox {
  id             String   @id @default(uuid()) @db.Uuid
  notificationId String   @db.Uuid
  recipientId    String   @db.Uuid
  title          String
  body           String
  read           Boolean  @default(false)
  readAt         DateTime?
  deleted        Boolean  @default(false)
  deletedAt      DateTime?

  createdAt      DateTime @default(now())

  notification   EnterpriseNotification @relation(fields: [notificationId], references: [id])

  @@index([recipientId])
  @@index([read])
  @@index([deleted])
  @@map("notification_inboxes")
}

/// Dispatch/Delivery Channels History Log
model NotificationHistory {
  id             String   @id @default(uuid()) @db.Uuid
  notificationId String   @db.Uuid
  recipientId    String?  @db.Uuid
  channel        String   // IN_APP | PUSH | WEBSOCKET | EMAIL | SMS
  status         String   // SENT | FAILED
  errorMessage   String?
  dispatchedAt   DateTime @default(now())

  notification   EnterpriseNotification @relation(fields: [notificationId], references: [id])

  @@index([notificationId])
  @@index([recipientId])
  @@map("notification_histories")
}

/// Pre-Aggregated Notification Statistics
model NotificationStatistics {
  id          String   @id @default(uuid()) @db.Uuid
  period      String   @default("DAILY")
  dateKey     String
  channel     String
  sentCount   Int      @default(0)
  readCount   Int      @default(0)
  failedCount Int      @default(0)

  updatedAt   DateTime @updatedAt

  @@unique([period, dateKey, channel])
  @@map("notification_statistics")
}

/// Audit Log for Notification Center Operations
model NotificationAudit {
  id             String   @id @default(uuid()) @db.Uuid
  notificationId String?  @db.Uuid
  actorId        String?  @db.Uuid
  action         String
  details        Json?
  createdAt      DateTime @default(now())

  @@index([notificationId])
  @@index([action])
  @@index([createdAt])
  @@map("notification_audits")
}

/// Dynamic Configuration Store
model NotificationConfiguration {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("notification_configurations")
}
