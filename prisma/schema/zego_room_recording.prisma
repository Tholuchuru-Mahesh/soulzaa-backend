/// Tracks a ZEGOCLOUD Cloud Recording task that continuously records the real
/// mixed audio of an audio room for the room's whole lifetime (started on the
/// first participant joining voice, stopped when the room empties/ends). This
/// is what makes a real "pre-report" window possible: Cloud Recording — like
/// every RTC recording product — can only record forward from when the task
/// starts, so a true 2-minutes-before-the-report buffer requires recording to
/// already be running, not started at report time.
///
/// `segments` accumulates one entry per completed recording chunk, reported by
/// ZEGO's server-to-server callback as the room stays active:
/// `[{ fileUrl: string, startedAt: ISO8601, endedAt: ISO8601 }, ...]`. At
/// report time, `RoomRecordingLifecycleService` slices out the segments that
/// overlap [reportTime-120s, reportTime+120s] and trims them into the exact
/// 4-minute evidence window.
model ZegoRoomRecordingTask {
  id          String                      @id @default(uuid()) @db.Uuid
  roomId      String                      @unique @db.Uuid
  taskId      String                      @unique
  roomType    ZegoRoomRecordingRoomType
  status      ZegoRoomRecordingTaskStatus @default(ACTIVE)
  startedAt   DateTime                    @default(now())
  stoppedAt   DateTime?
  segments    Json                        @default("[]")
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  @@index([status])
  @@map("zego_room_recording_tasks")
}

enum ZegoRoomRecordingRoomType {
  audio
  video
  stream
}

enum ZegoRoomRecordingTaskStatus {
  ACTIVE
  STOPPED
  FAILED
}
