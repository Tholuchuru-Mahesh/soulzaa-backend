model RoomActivity {
  id                   String   @id @default(uuid()) @db.Uuid
  roomId               String   @unique @db.Uuid
  peakParticipants     Int      @default(0)
  totalJoined          Int      @default(0)
  totalGifts           Int      @default(0)
  totalGiftCoins       BigInt   @default(0)
  totalSpeakingMinutes Int      @default(0)
  durationSeconds      Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([roomId])
  @@map("room_activities")
}

model RoomVisitor {
  id              String    @id @default(uuid()) @db.Uuid
  roomId          String    @db.Uuid
  userId          String    @db.Uuid
  joinedAt        DateTime  @default(now())
  leftAt          DateTime?
  durationSeconds Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([roomId, userId])
  @@map("room_visitors")
}

model SpeakerSession {
  id              String    @id @default(uuid()) @db.Uuid
  roomId          String    @db.Uuid
  userId          String    @db.Uuid
  joinedSeatAt    DateTime  @default(now())
  leftSeatAt      DateTime?
  speakingSeconds Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([roomId, userId])
  @@map("speaker_sessions")
}

model RevenueReport {
  id           String   @id @default(uuid()) @db.Uuid
  dateKey      String
  roomId       String   @db.Uuid
  userId       String   @db.Uuid
  giftCoins    BigInt   @default(0)
  creatorCoins BigInt   @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([dateKey, roomId, userId])
  @@map("revenue_reports")
}

model RoomDailyStat {
  id               String   @id @default(uuid()) @db.Uuid
  dateKey          String
  roomId           String   @db.Uuid
  joins            Int      @default(0)
  uniqueVisitors   Int      @default(0)
  peakParticipants Int      @default(0)
  messages         Int      @default(0)
  giftCount        Int      @default(0)
  giftCoins        BigInt   @default(0)
  speakingSeconds  BigInt   @default(0)
  engagementScore  Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([dateKey, roomId])
  @@index([roomId, dateKey])
  @@map("room_daily_stats")
}

model CreatorDailyStat {
  id                 String   @id @default(uuid()) @db.Uuid
  dateKey            String
  userId             String   @db.Uuid
  giftsReceivedCount Int      @default(0)
  giftCoinsReceived  BigInt   @default(0)
  creatorEarnings    BigInt   @default(0)
  roomsHosted        Int      @default(0)
  speakingSeconds    BigInt   @default(0)
  engagementScore    Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([dateKey, userId])
  @@index([userId, dateKey])
  @@map("creator_daily_stats")
}

/// Analytics Report Record
model AnalyticsReport {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  domain      String
  parameters  Json?
  data        Json?
  generatedBy String?        @db.Uuid
  createdAt   DateTime       @default(now())
  exports     ReportExport[]

  @@index([domain])
  @@index([createdAt])
  @@map("analytics_reports")
}

/// Analytics Time-series Snapshot for aggregation trends
model AnalyticsSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  domain      String
  metricKey   String
  metricValue Float
  timestamp   DateTime @default(now())

  @@index([domain, metricKey, timestamp])
  @@map("analytics_snapshots")
}

/// Live KPI Metric Value
model AnalyticsMetric {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("analytics_metrics")
}

/// Configurable Dashboard Layouts
model AnalyticsDashboard {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  layout      Json?
  metrics     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("analytics_dashboards")
}

/// Dynamic aggregated statistics per period
model AnalyticsStatistics {
  id         String   @id @default(uuid()) @db.Uuid
  period     String   @default("DAILY")
  dateKey    String
  metricType String
  count      Int      @default(0)
  amount     Decimal  @default(0.0) @db.Decimal(20, 2)
  updatedAt  DateTime @updatedAt

  @@unique([period, dateKey, metricType])
  @@map("analytics_statistics")
}

/// Analytical Engine Audit Log
model AnalyticsAudit {
  id        String   @id @default(uuid()) @db.Uuid
  reportId  String?  @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  details   Json?
  createdAt DateTime @default(now())

  @@index([reportId])
  @@index([action])
  @@index([createdAt])
  @@map("analytics_audits")
}

/// Analytics configuration settings
model AnalyticsConfiguration {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("analytics_configurations")
}

/// Export requests registry
model ReportExport {
  id        String          @id @default(uuid()) @db.Uuid
  reportId  String          @db.Uuid
  format    String
  url       String?
  status    String          @default("PENDING")
  expiresAt DateTime?
  createdAt DateTime        @default(now())
  report    AnalyticsReport @relation(fields: [reportId], references: [id])

  @@index([reportId])
  @@map("report_exports")
}
