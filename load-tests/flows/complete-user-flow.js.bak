import { group, check, sleep } from 'k6';
import { login } from '../utils/auth.js';
import { authenticatedRequest } from '../utils/http.js';
import { config } from '../config/environments.js';
import { randomString } from '../utils/random.js';

export function setup() {
  const token = login(0);
  return { token };
}

export default function(data) {
  const token = data.token;
  const BASE_URL = config.BASE_URL;

  group('Complete User Flow: Login -> Profile -> Create Event -> View List -> Logout', function() {
    
    // 1. Get Profile
    group('Get Profile', function() {
      const res = authenticatedRequest('GET', `${BASE_URL}/users/me`, null, token);
      check(res, { 'profile retrieved': (r) => r.status === 200 });
      sleep(1);
    });

    // 2. View Dashboard/Feed
    group('View Dashboard', function() {
      const res = authenticatedRequest('GET', `${BASE_URL}/events?limit=10&page=1`, null, token);
      check(res, { 'dashboard loaded': (r) => r.status === 200 });
      sleep(2); // Simulated read time
    });

    // 3. Create Event (Destructive - safe prefix used)
    let eventId = null;
    group('Create Event', function() {
      const payload = {
        title: `loadtest_event_${randomString(5)}`,
        description: 'Generated by k6 load test',
        startTime: new Date(Date.now() + 86400000).toISOString(),
        endTime: new Date(Date.now() + 86400000 * 2).toISOString(),
      };
      const res = authenticatedRequest('POST', `${BASE_URL}/events`, payload, token);
      check(res, { 'event created': (r) => r.status === 201 || r.status === 200 });
      
      try {
        eventId = res.json().id || res.json().data?.id;
      } catch(e) {}
      sleep(1);
    });

    // 4. Update Event (if created)
    if (eventId) {
      group('Update Event', function() {
        const payload = { description: 'Updated description by k6' };
        const res = authenticatedRequest('PATCH', `${BASE_URL}/events/${eventId}`, payload, token);
        check(res, { 'event updated': (r) => r.status === 200 });
        sleep(1);
      });
      
      // 5. Delete Event (Cleanup)
      group('Delete Event', function() {
        const res = authenticatedRequest('DELETE', `${BASE_URL}/events/${eventId}`, null, token);
        check(res, { 'event deleted': (r) => [200, 204].includes(r.status) });
      });
    }
  });
}
