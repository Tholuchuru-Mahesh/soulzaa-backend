# Allow postinstall/build scripts for native and prisma packages.
# pnpm 11+ blocks these by default (ERR_PNPM_IGNORED_BUILDS).
# This file is always read — even with --frozen-lockfile in CI.
unsafe-perm=true
only-built-dependencies[]=@firebase/util
only-built-dependencies[]=@prisma/client
only-built-dependencies[]=@prisma/engines
only-built-dependencies[]=@scarf/scarf
only-built-dependencies[]=msgpackr-extract
only-built-dependencies[]=prisma
only-built-dependencies[]=protobufjs
only-built-dependencies[]=sharp
only-built-dependencies[]=@swc/core
