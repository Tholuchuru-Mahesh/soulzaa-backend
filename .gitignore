# compiled output
/dist
/node_modules
/build

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.local
.env.*.local
# Every real env file, not just the local ones. `.env.production` is what
# docker-compose.prod.yml feeds the container on EC2 and holds live secrets;
# it was previously un-ignored, so a stray `git add .` would have committed it.
.env.production
.env.testing
.env.staging
.env.qa
.env.development
# The tracked template stays tracked — it carries key names, never values.
!.env.example


# OS / IDE
.DS_Store
.idea
.vscode/*
!.vscode/extensions.json

# Tests
/coverage
/.nyc_output

# Misc
*.pem
.pnpm-store

# Firebase Admin SDK service account key — NEVER commit.
# Lives only on the server; a committed key gets auto-disabled by Google.
firebase-service-account.json

# Compiled output from a stray tsc run over test/. These were committed once and
# broke lint: eslint parsed the emitted .d.ts files, which belong to no tsconfig.
test/**/*.js
test/**/*.js.map
test/**/*.d.ts

# TypeScript incremental build cache — regenerated per machine, never source
*.tsbuildinfo

# Local env backups — never commit; these carry real secrets
.env.bak*
.env.*.bak
*.conflict.bak

.worktrees/
