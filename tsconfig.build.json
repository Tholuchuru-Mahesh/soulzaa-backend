{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src"
  },
  // prisma/ and scripts/ hold standalone .ts utilities. Compiling them widens
  // TypeScript's common source root to the repo root, which emits dist/src/main.js
  // instead of dist/main.js — the path both the Dockerfile CMD and start:prod use.
  "compilerOptions": {
    "incremental": false
  },
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts", "prisma", "scripts"]
}
