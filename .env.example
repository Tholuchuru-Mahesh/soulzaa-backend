# ============================================================
# Soulzaa Backend — Environment (copy to .env and fill in)
# Validated at boot by src/config/env.validation.ts (Zod).
# ============================================================

# ---- Runtime ----
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Comma-separated origins, or "*" for all
CORS_ORIGINS=*
LOG_LEVEL=info

# ---- Database (Postgres / Prisma) ----
# Local dev talks straight to Postgres. To route app traffic through PgBouncer
# (started via `docker compose --profile full up`), instead use:
#   DATABASE_URL=postgresql://soulzaa:soulzaa@localhost:6432/soulzaa?schema=public&pgbouncer=true
DATABASE_URL=postgresql://soulzaa:soulzaa@localhost:5432/soulzaa?schema=public
# Direct-to-Postgres connection for migrations/introspection (bypasses PgBouncer).
# Leave unset to reuse DATABASE_URL; set it whenever DATABASE_URL points at the pooler.
DIRECT_URL=postgresql://soulzaa:soulzaa@localhost:5432/soulzaa?schema=public
# ---- Connection pool tuning (Prisma client-side pool) ----
# Max pooled connections per app instance. Unset = Prisma default (num_cpus*2+1).
# DATABASE_CONNECTION_LIMIT=20
# Seconds to wait for a free connection before erroring (default 10).
DATABASE_POOL_TIMEOUT=10
# Seconds to wait to establish a new connection (default 5).
DATABASE_CONNECT_TIMEOUT=5

# ---- Distributed tracing (OpenTelemetry, AR-15) ----
# Off by default. Set OTEL_ENABLED=true and point the endpoint at an OTLP/HTTP
# collector (Jaeger/Tempo/Grafana Agent) to export traces. The pino
# instrumentation injects trace_id/span_id into logs for trace<->log correlation.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=soulzaa-backend
# OTEL_SERVICE_VERSION=1.0.0
# Head-sampling ratio for new root traces (0..1). Use <1 in production.
OTEL_TRACES_SAMPLER_RATIO=1

# ---- Redis (cache, presence, locks, leaderboards, socket adapter, BullMQ) ----
REDIS_URL=redis://localhost:6379
# Optional: run in Cluster mode instead of standalone. Comma-separated host:port
# startup nodes, e.g. REDIS_CLUSTER_NODES=node1:6379,node2:6379,node3:6379
REDIS_CLUSTER_NODES=

# ---- Auth / JWT (use long random strings in production) ----
JWT_ACCESS_SECRET=change_me_access_secret_min_16_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_min_16_chars
JWT_REFRESH_TTL=30d
# bcrypt cost factor for password hashing (higher = slower/safer).
BCRYPT_SALT_ROUNDS=12

# ---- OTP (mobile + email one-time codes) ----
OTP_LENGTH=6
# Code lifetime (PRD: 60 second timer).
OTP_TTL_SECONDS=60
OTP_MAX_ATTEMPTS=5
# Max re-sends before the destination is temporarily blocked.
OTP_MAX_RESENDS=5
# Minimum seconds between successive re-sends to the same destination.
OTP_RESEND_COOLDOWN_SECONDS=30
# How long a destination stays blocked after abuse.
OTP_BLOCK_SECONDS=900
# Maintenance: prune expired OTP audit rows on this cron, keeping this retention window.
OTP_CLEANUP_CRON=*/15 * * * *
OTP_RETENTION_HOURS=24
# Delivery providers. SMS: console | twilio | msg91 | aws_sns. Email: console | smtp.
OTP_SMS_PROVIDER=console
OTP_EMAIL_PROVIDER=console
# Provider credentials (fill in only for the selected provider).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=
# AWS SNS reuses AWS_REGION / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY below.

# ---- Login security ----
# Failed logins before a temporary lock, and lock duration.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=900
# Password-reset token lifetime (seconds).
PASSWORD_RESET_TTL_SECONDS=900
# Minimum account age (18+ platform).
MIN_USER_AGE=18

# ---- User profiles ----
# Public base URL (CDN) for serving avatar/cover media. Leave empty to fall
# back to short-lived presigned GET URLs.
MEDIA_PUBLIC_BASE_URL=
# Profile sharing links.
SHARE_BASE_URL=https://soulzaa.app
APP_DEEPLINK_SCHEME=soulzaa://
# Composed-profile cache lifetime (seconds).
PROFILE_CACHE_TTL_SECONDS=300

# ---- Push notifications (device login alerts, FCM/APNS) ----
# Delivery provider: console | fcm | apns.
PUSH_PROVIDER=console
# Push a login alert to a user's other devices on a suspicious login.
SUSPICIOUS_LOGIN_ALERTS=true
# Firebase Cloud Messaging (fill in only when PUSH_PROVIDER=fcm).
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=
# Apple Push Notification service (fill in only when PUSH_PROVIDER=apns).
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=
# APNS_PRIVATE_KEY=

# ---- Privacy ----
# Cache lifetime (seconds) for privacy settings + block checks.
PRIVACY_CACHE_TTL_SECONDS=300
# Default visibility for new users: EVERYONE | FRIENDS_ONLY | FOLLOWERS_ONLY | NOBODY.
PRIVACY_DEFAULT_VISIBILITY=EVERYONE

# ---- Sessions ----
# Max concurrent active sessions per user (oldest evicted past this).
SESSION_MAX_CONCURRENT=5
# Idle window (seconds) before a session expires from inactivity.
SESSION_INACTIVITY_SECONDS=1800
# Absolute session lifetime cap (seconds); default = 30d refresh window.
SESSION_ABSOLUTE_TTL_SECONDS=2592000
# Treat a changed client IP on refresh as session hijacking (strict).
SESSION_HIJACK_STRICT_IP=false

# ---- Social login (Google / Apple ID-token verification) ----
# Comma-separated allowed audiences (OAuth client ids). Leave empty to disable.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
APPLE_ISSUER=https://appleid.apple.com

# ---- AWS S3 (media storage) ----
# For LOCAL dev with the docker-compose MinIO service, use:
#   AWS_ACCESS_KEY_ID=minioadmin  AWS_SECRET_ACCESS_KEY=minioadmin
#   S3_ENDPOINT=http://localhost:9000  S3_FORCE_PATH_STYLE=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=soulzaa-media
# Set for S3-compatible/local (e.g. MinIO). Leave empty for real AWS S3.
S3_ENDPOINT=
# Host used to SIGN presigned upload/download URLs when it must differ from
# S3_ENDPOINT — e.g. local dev where the backend reaches MinIO on localhost but a
# physical device must reach it via the machine's LAN IP (e.g.
# http://192.168.x.x:9000, matching API_BASE_URL's host). Leave empty in prod.
S3_PUBLIC_ENDPOINT=
# Must be true for MinIO/path-style endpoints.
S3_FORCE_PATH_STYLE=false
S3_PRESIGN_EXPIRY_SECONDS=900

# ---- Agora (audio/video infrastructure) ----
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_EXPIRY_SECONDS=3600

# ---- ZEGOCLOUD (Audio Room voice) ----
# Numeric ZEGO AppID and the 32-character server secret from the ZEGO console.
ZEGO_APP_ID=
ZEGO_SERVER_SECRET=
ZEGO_TOKEN_EXPIRY_SECONDS=3600

# ---- Audio Rooms ----
AUDIO_ROOM_DEFAULT_MAX_PARTICIPANTS=50
AUDIO_ROOM_MAX_PARTICIPANTS_CAP=500
AUDIO_ROOM_CACHE_TTL_SECONDS=60
AUDIO_ROOM_TRENDING_WINDOW_SECONDS=3600
# Stage seat layout (owner seat is always present and not counted here)
AUDIO_ROOM_DEFAULT_SPEAKER_SEATS=8
AUDIO_ROOM_DEFAULT_PREMIUM_ADMIN_SEATS=0
AUDIO_ROOM_SEAT_INVITATION_TTL_SECONDS=120
# Chat / anti-abuse (AR-4)
AUDIO_ROOM_CHAT_MESSAGE_MAX_LENGTH=1000
AUDIO_ROOM_CHAT_MAX_MENTIONS=10
AUDIO_ROOM_CHAT_MAX_PINS=5
AUDIO_ROOM_CHAT_RATE_MAX=10
AUDIO_ROOM_CHAT_RATE_WINDOW_SECONDS=10
AUDIO_ROOM_CHAT_DEDUP_WINDOW_SECONDS=30
AUDIO_ROOM_CHAT_REACT_RATE_MAX=15
AUDIO_ROOM_CHAT_REACT_RATE_WINDOW_SECONDS=10
AUDIO_ROOM_CHAT_VIOLATION_WINDOW_SECONDS=3600
AUDIO_ROOM_CHAT_AUTO_MUTE_THRESHOLD=3
AUDIO_ROOM_CHAT_AUTO_KICK_THRESHOLD=6
AUDIO_ROOM_CHAT_AUTO_MUTE_MINUTES=15
AUDIO_ROOM_CHAT_BLOCKED_WORD_RELOAD_SECONDS=300
# Premium features (AR-9)
AUDIO_ROOM_PREMIUM_SEAT_PRICE_GOLD=50000
AUDIO_ROOM_PREMIUM_SEAT_DURATION_DAYS=30

# ---- Video Rooms (VR-0 foundation) ----
# Seat-holder (participant) caps for a new room and the hard upper bound.
VIDEO_ROOM_DEFAULT_MAX_PARTICIPANTS=12
VIDEO_ROOM_MAX_PARTICIPANTS_CAP=20
# Audience (viewer) caps for a new room and the hard upper bound.
VIDEO_ROOM_DEFAULT_MAX_VIEWERS=500
VIDEO_ROOM_MAX_VIEWERS_CAP=5000
# Client heartbeat cadence (seconds) the session layer expects.
VIDEO_ROOM_HEARTBEAT_INTERVAL_SECONDS=25
# Grace window for a dropped client to reconnect before its session is reclaimed.
VIDEO_ROOM_RECONNECT_TIMEOUT_SECONDS=120
VIDEO_ROOM_MAX_RECONNECT_ATTEMPTS=5
# Idle host/room timeout (seconds) before the room is considered dormant.
VIDEO_ROOM_IDLE_TIMEOUT_SECONDS=300
# How often the session/presence expiry sweep runs (seconds).
VIDEO_ROOM_CLEANUP_INTERVAL_SECONDS=30
# Per-session heartbeat TTL (seconds): no heartbeat within this window ⇒ stale.
VIDEO_ROOM_SESSION_TTL_SECONDS=90
# Room state-snapshot cache TTL (seconds).
VIDEO_ROOM_STATE_TTL_SECONDS=300
# Room read-snapshot cache TTL (seconds).
VIDEO_ROOM_CACHE_TTL_SECONDS=60
# Default stream quality (SD | HD | FHD) and the advertised bitrate ceiling (kbps).
VIDEO_ROOM_DEFAULT_QUALITY=HD
VIDEO_ROOM_MAX_BITRATE_KBPS=2500
# Max concurrent non-deleted rooms one owner may host (VR-2 lifecycle cap).
VIDEO_ROOM_MAX_ROOMS_PER_OWNER=1
# Viewer-mode audience source (VR-6): durable (member-is-viewer) | ephemeral (future).
VIDEO_ROOM_VIEWER_PRESENCE_MODE=durable

# ---- Video Room media (VR-5) ----
# Per-publisher heartbeat TTL (seconds): no heartbeat within this window ⇒ stale.
VIDEO_ROOM_MEDIA_HEARTBEAT_TTL_SECONDS=30
# How often the media-expiry sweep runs (seconds).
VIDEO_ROOM_MEDIA_MONITOR_INTERVAL_SECONDS=10
# Grace window for a dropped publisher to reconnect before recovery gives up (seconds).
VIDEO_ROOM_MEDIA_RECONNECT_GRACE_SECONDS=60
# TTL of a recovery grant token issued during the reconnect grace window (seconds).
VIDEO_ROOM_MEDIA_RECOVERY_TOKEN_TTL_SECONDS=60
# Most concurrent stream subscriptions a single viewer may hold.
VIDEO_ROOM_MAX_SUBSCRIPTIONS_PER_USER=20
# Sample 1-in-N quality reports per publisher to bound write volume.
VIDEO_ROOM_MEDIA_QUALITY_SAMPLE_EVERY=6
# Default beauty-filter level (0-100) applied to a new stream.
VIDEO_ROOM_DEFAULT_BEAUTY_LEVEL=0

# ---- Gifts (AR-5) ----
GIFT_CREATOR_EARNING_RATE_PERCENT=30
GIFT_SENDER_EXP_PER_COIN=1
GIFT_RECEIVER_EXP_PER_COIN=1
GIFT_RATE_MAX=20
GIFT_RATE_WINDOW_SECONDS=10
GIFT_LEADERBOARD_RETENTION_DAYS=60

# ---- Queue (BullMQ) ----
QUEUE_PREFIX=soulzaa
# Worker concurrency per queue, default retry attempts, metrics sampling interval.
QUEUE_CONCURRENCY=5
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_METRICS_INTERVAL_MS=15000
# Bull Board dashboard (served under the API prefix, e.g. /api/admin/queues).
# It mounts an Express router that bypasses Nest guards, so it is protected with
# HTTP Basic auth — CHANGE THE PASSWORD before exposing it, or front it with a proxy.
QUEUE_DASHBOARD_ROUTE=/admin/queues
QUEUE_DASHBOARD_USER=admin
QUEUE_DASHBOARD_PASSWORD=soulzaa

# ---- Observability ----
METRICS_ENABLED=true
# Slow-operation thresholds (ms) for warning/error logs + liveness event-loop lag.
SLOW_QUERY_WARN_MS=100
SLOW_QUERY_ERROR_MS=500
SLOW_REDIS_MS=50
SLOW_REQUEST_MS=1000
LIVENESS_MAX_EVENT_LOOP_LAG_MS=200

# ---- Video Room gift engine (VR-10) ----
# Max recipients a single send may target (MULTI / SEAT_ALL).
VIDEO_ROOM_GIFT_MAX_RECEIVERS=9
# Future-ready "gift the whole room" target. Keep false until product enables it.
VIDEO_ROOM_GIFT_ALLOW_ROOM_ALL=false
# Default for video_room_settings.metadata.allowViewerGifts.
VIDEO_ROOM_GIFT_ALLOW_VIEWER_DEFAULT=true
# Capped length of the per-room recent-gift feed.
VIDEO_ROOM_GIFT_RECENT_FEED_SIZE=50
# Monitor tick: sweeps expired combos and (optionally) replays the DLQ.
VIDEO_ROOM_GIFT_MONITOR_INTERVAL_SECONDS=15
# Automatic dead-letter replay of failed gift deliveries.
VIDEO_ROOM_GIFT_RECOVERY_ENABLED=false

# ---- VR-11 Treasure Box engine (video rooms) ----
# Master switch. When false, treasure lifecycle commands are refused.
VIDEO_ROOM_TREASURE_ENABLED=true
# Reward pool as a share of the level threshold, in basis points (1000 = 10%).
# The pool is MINTED by the platform: gift coins raise a counter, they are never
# escrowed, so the receiver still earns their VR-10 creator share.
VIDEO_ROOM_TREASURE_POOL_BPS=1000
# Winners drawn per box when the level does not override it.
VIDEO_ROOM_TREASURE_WINNER_COUNT=3
# Candidates sampled from presence = max(winnerCount * FACTOR, MIN), then filtered
# in Postgres. Oversampling is what keeps a 100k-viewer room O(candidates).
VIDEO_ROOM_TREASURE_OVERSAMPLE_FACTOR=3
VIDEO_ROOM_TREASURE_OVERSAMPLE_MIN=50
# Eligibility floors. Stay time rewards presence; activity is opt-in at 0.
VIDEO_ROOM_TREASURE_MIN_STAY_SECONDS=120
VIDEO_ROOM_TREASURE_MIN_ACTIVITY_EVENTS=0
# Ceiling on treasureProgressUpdated broadcasts per room per second. Threshold
# crossings always bypass this.
VIDEO_ROOM_TREASURE_PROGRESS_EMIT_PER_SECOND=5
# A box left UNLOCKING longer than this with no pool row is re-enqueued.
VIDEO_ROOM_TREASURE_ORPHAN_TIMEOUT_SECONDS=120
# Automatic reclaim of orphaned unlocks and dead-lettered unlock jobs.
VIDEO_ROOM_TREASURE_RECOVERY_ENABLED=false
VIDEO_ROOM_TREASURE_MONITOR_INTERVAL_SECONDS=30

# ---- VR-12 PK Battle engine (video rooms) ----
# Master switch. When false, every PK lifecycle command is refused.
VIDEO_ROOM_PK_ENABLED=true
# Pre-battle countdown before the clock starts.
VIDEO_ROOM_PK_COUNTDOWN_SECONDS=10
VIDEO_ROOM_PK_MIN_DURATION_SECONDS=60
VIDEO_ROOM_PK_MAX_DURATION_SECONDS=1800
VIDEO_ROOM_PK_DEFAULT_DURATION_SECONDS=300
# How long an invitation stays actionable.
VIDEO_ROOM_PK_INVITATION_TTL_SECONDS=60
# Share of BASE contribution minted as the reward pool (1000 = 10%).
VIDEO_ROOM_PK_POOL_BPS=1000
# Split of the pool. winner + participation + bonus must be <= 10000.
VIDEO_ROOM_PK_WINNER_BPS=6000
VIDEO_ROOM_PK_PARTICIPATION_BPS=3000
VIDEO_ROOM_PK_BONUS_BPS=1000
# Ceiling on the composed score multiplier. 30000 = 3.0x.
VIDEO_ROOM_PK_MULTIPLIER_CAP_BPS=30000
# Bonus bps added per VIP tier level.
VIDEO_ROOM_PK_VIP_BONUS_BPS_PER_TIER=500
VIDEO_ROOM_PK_EVENT_BONUS_BPS=0
VIDEO_ROOM_PK_EVENT_MULTIPLIER_ENABLED=false
# Ceiling on pkScoreUpdated broadcasts per battle per second.
VIDEO_ROOM_PK_SCORE_EMIT_PER_SECOND=10
# Automatic settlement of orphaned RECOVERING battles.
VIDEO_ROOM_PK_RECOVERY_ENABLED=false
VIDEO_ROOM_PK_MONITOR_INTERVAL_SECONDS=15
# A RECOVERING battle older than this is settled with current scores.
VIDEO_ROOM_PK_ORPHAN_TIMEOUT_SECONDS=120
# Grace given to a dropped host before the battle is settled.
VIDEO_ROOM_PK_RECOVERY_GRACE_SECONDS=45
VIDEO_ROOM_PK_MAX_PER_SWEEP=50

# ---- VR-16 Moderation & safety engine (video rooms) ----
# Auto-mod thresholds mirror the audio-room chat auto-mod defaults (mute
# threshold 3, mute minutes 15, dedup window 30).
VIDEO_ROOM_MOD_SPAM_THRESHOLD=5
VIDEO_ROOM_MOD_SPAM_WINDOW_SEC=60
VIDEO_ROOM_MOD_FLOOD_THRESHOLD=10
VIDEO_ROOM_MOD_FLOOD_WINDOW_SEC=10
# Duplicate-message suppression window feeding the duplicate detector.
VIDEO_ROOM_MOD_DUP_WINDOW_SEC=30
VIDEO_ROOM_MOD_RAPID_JOINLEAVE_THRESHOLD=5
VIDEO_ROOM_MOD_RAPID_JOINLEAVE_WINDOW_SEC=60
VIDEO_ROOM_MOD_EXCESSIVE_REPORTS_THRESHOLD=5
VIDEO_ROOM_MOD_EXCESSIVE_REPORTS_WINDOW_SEC=300
# Informational only — never auto-escalates.
VIDEO_ROOM_MOD_WARNING_THRESHOLD=3
VIDEO_ROOM_MOD_AUTO_MUTE_MINUTES=15
# Per-user cooldown after an auto action fires, suppressing repeat auto actions.
VIDEO_ROOM_MOD_AUTO_ACTION_COOLDOWN_SEC=30
# How often the temp-mute expiry sweep runs (ms).
VIDEO_ROOM_MOD_EXPIRY_MONITOR_INTERVAL_MS=15000
# Mirrors the fixed VIDEO_ROOM_MODERATION_REASON_MAX / _DESCRIPTION_MAX DTO bounds.
VIDEO_ROOM_MOD_REASON_MAX=500
VIDEO_ROOM_MOD_DESCRIPTION_MAX=1000
