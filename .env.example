# ============================================================
# Soulzaa Backend — Environment (copy to .env and fill in)
# Validated at boot by src/config/env.validation.ts (Zod).
# ============================================================

# ---- Runtime ----
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Comma-separated origins, or "*" for all
CORS_ORIGINS=*
LOG_LEVEL=info

# ---- Database (Postgres / Prisma) ----
# Local dev talks straight to Postgres. To route app traffic through PgBouncer
# (started via `docker compose --profile full up`), instead use:
#   DATABASE_URL=postgresql://soulzaa:soulzaa@localhost:6432/soulzaa?schema=public&pgbouncer=true
DATABASE_URL=postgresql://soulzaa:soulzaa@localhost:5432/soulzaa?schema=public
# Direct-to-Postgres connection for migrations/introspection (bypasses PgBouncer).
# Leave unset to reuse DATABASE_URL; set it whenever DATABASE_URL points at the pooler.
DIRECT_URL=postgresql://soulzaa:soulzaa@localhost:5432/soulzaa?schema=public
# ---- Connection pool tuning (Prisma client-side pool) ----
# Max pooled connections per app instance. Unset = Prisma default (num_cpus*2+1).
# DATABASE_CONNECTION_LIMIT=20
# Seconds to wait for a free connection before erroring (default 10).
DATABASE_POOL_TIMEOUT=10
# Seconds to wait to establish a new connection (default 5).
DATABASE_CONNECT_TIMEOUT=5

# ---- Distributed tracing (OpenTelemetry, AR-15) ----
# Off by default. Set OTEL_ENABLED=true and point the endpoint at an OTLP/HTTP
# collector (Jaeger/Tempo/Grafana Agent) to export traces. The pino
# instrumentation injects trace_id/span_id into logs for trace<->log correlation.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=soulzaa-backend
# OTEL_SERVICE_VERSION=1.0.0
# Head-sampling ratio for new root traces (0..1). Use <1 in production.
OTEL_TRACES_SAMPLER_RATIO=1

# ---- Redis (cache, presence, locks, leaderboards, socket adapter, BullMQ) ----
REDIS_URL=redis://localhost:6379
# Optional: run in Cluster mode instead of standalone. Comma-separated host:port
# startup nodes, e.g. REDIS_CLUSTER_NODES=node1:6379,node2:6379,node3:6379
REDIS_CLUSTER_NODES=

# ---- Auth / JWT (use long random strings in production) ----
JWT_ACCESS_SECRET=change_me_access_secret_min_16_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_min_16_chars
JWT_REFRESH_TTL=30d
# bcrypt cost factor for password hashing (higher = slower/safer).
BCRYPT_SALT_ROUNDS=12

# ---- OTP (mobile + email one-time codes) ----
OTP_LENGTH=6
# Code lifetime (PRD: 60 second timer).
OTP_TTL_SECONDS=60
OTP_MAX_ATTEMPTS=5
# Max re-sends before the destination is temporarily blocked.
OTP_MAX_RESENDS=5
# Minimum seconds between successive re-sends to the same destination.
OTP_RESEND_COOLDOWN_SECONDS=30
# How long a destination stays blocked after abuse.
OTP_BLOCK_SECONDS=900
# Maintenance: prune expired OTP audit rows on this cron, keeping this retention window.
OTP_CLEANUP_CRON=*/15 * * * *
OTP_RETENTION_HOURS=24
# Delivery providers. SMS: console | twilio | msg91 | aws_sns. Email: console | smtp.
OTP_SMS_PROVIDER=console
OTP_EMAIL_PROVIDER=console
# Provider credentials (fill in only for the selected provider).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=
# AWS SNS reuses AWS_REGION / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY below.

# ---- Login security ----
# Failed logins before a temporary lock, and lock duration.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=900
# Password-reset token lifetime (seconds).
PASSWORD_RESET_TTL_SECONDS=900
# Minimum account age (18+ platform).
MIN_USER_AGE=18

# ---- User profiles ----
# Public base URL (CDN) for serving avatar/cover media. Leave empty to fall
# back to short-lived presigned GET URLs.
MEDIA_PUBLIC_BASE_URL=
# Profile sharing links.
SHARE_BASE_URL=https://soulzaa.app
APP_DEEPLINK_SCHEME=soulzaa://
# Composed-profile cache lifetime (seconds).
PROFILE_CACHE_TTL_SECONDS=300

# ---- Push notifications (device login alerts, FCM/APNS) ----
# Delivery provider: console | fcm | apns.
PUSH_PROVIDER=console
# Push a login alert to a user's other devices on a suspicious login.
SUSPICIOUS_LOGIN_ALERTS=true
# Firebase Cloud Messaging (fill in only when PUSH_PROVIDER=fcm).
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=
# Apple Push Notification service (fill in only when PUSH_PROVIDER=apns).
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=
# APNS_PRIVATE_KEY=

# ---- Privacy ----
# Cache lifetime (seconds) for privacy settings + block checks.
PRIVACY_CACHE_TTL_SECONDS=300
# Default visibility for new users: EVERYONE | FRIENDS_ONLY | FOLLOWERS_ONLY | NOBODY.
PRIVACY_DEFAULT_VISIBILITY=EVERYONE

# ---- Sessions ----
# Max concurrent active sessions per user (oldest evicted past this).
SESSION_MAX_CONCURRENT=5
# Idle window (seconds) before a session expires from inactivity.
SESSION_INACTIVITY_SECONDS=1800
# Absolute session lifetime cap (seconds); default = 30d refresh window.
SESSION_ABSOLUTE_TTL_SECONDS=2592000
# Treat a changed client IP on refresh as session hijacking (strict).
SESSION_HIJACK_STRICT_IP=false

# ---- Social login (Google / Apple ID-token verification) ----
# Comma-separated allowed audiences (OAuth client ids). Leave empty to disable.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
APPLE_ISSUER=https://appleid.apple.com

# ---- AWS S3 (media storage) ----
# For LOCAL dev with the docker-compose MinIO service, use:
#   AWS_ACCESS_KEY_ID=minioadmin  AWS_SECRET_ACCESS_KEY=minioadmin
#   S3_ENDPOINT=http://localhost:9000  S3_FORCE_PATH_STYLE=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=soulzaa-media
# Set for S3-compatible/local (e.g. MinIO). Leave empty for real AWS S3.
S3_ENDPOINT=
# Must be true for MinIO/path-style endpoints.
S3_FORCE_PATH_STYLE=false
S3_PRESIGN_EXPIRY_SECONDS=900

# ---- Agora (audio/video infrastructure) ----
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_EXPIRY_SECONDS=3600

# ---- ZEGOCLOUD (Audio Room voice) ----
# Numeric ZEGO AppID and the 32-character server secret from the ZEGO console.
ZEGO_APP_ID=
ZEGO_SERVER_SECRET=
ZEGO_TOKEN_EXPIRY_SECONDS=3600

# ---- Audio Rooms ----
AUDIO_ROOM_DEFAULT_MAX_PARTICIPANTS=50
AUDIO_ROOM_MAX_PARTICIPANTS_CAP=500
AUDIO_ROOM_CACHE_TTL_SECONDS=60
AUDIO_ROOM_TRENDING_WINDOW_SECONDS=3600
# Stage seat layout (owner seat is always present and not counted here)
AUDIO_ROOM_DEFAULT_SPEAKER_SEATS=8
AUDIO_ROOM_DEFAULT_PREMIUM_ADMIN_SEATS=0
AUDIO_ROOM_SEAT_INVITATION_TTL_SECONDS=120
# Chat / anti-abuse (AR-4)
AUDIO_ROOM_CHAT_MESSAGE_MAX_LENGTH=1000
AUDIO_ROOM_CHAT_MAX_MENTIONS=10
AUDIO_ROOM_CHAT_MAX_PINS=5
AUDIO_ROOM_CHAT_RATE_MAX=10
AUDIO_ROOM_CHAT_RATE_WINDOW_SECONDS=10
AUDIO_ROOM_CHAT_DEDUP_WINDOW_SECONDS=30
AUDIO_ROOM_CHAT_REACT_RATE_MAX=15
AUDIO_ROOM_CHAT_REACT_RATE_WINDOW_SECONDS=10
AUDIO_ROOM_CHAT_VIOLATION_WINDOW_SECONDS=3600
AUDIO_ROOM_CHAT_AUTO_MUTE_THRESHOLD=3
AUDIO_ROOM_CHAT_AUTO_KICK_THRESHOLD=6
AUDIO_ROOM_CHAT_AUTO_MUTE_MINUTES=15
AUDIO_ROOM_CHAT_BLOCKED_WORD_RELOAD_SECONDS=300
# Premium features (AR-9)
AUDIO_ROOM_PREMIUM_SEAT_PRICE_GOLD=50000
AUDIO_ROOM_PREMIUM_SEAT_DURATION_DAYS=30

# ---- Gifts (AR-5) ----
GIFT_CREATOR_EARNING_RATE_PERCENT=30
GIFT_SENDER_EXP_PER_COIN=1
GIFT_RECEIVER_EXP_PER_COIN=1
GIFT_RATE_MAX=20
GIFT_RATE_WINDOW_SECONDS=10
GIFT_LEADERBOARD_RETENTION_DAYS=60

# ---- Queue (BullMQ) ----
QUEUE_PREFIX=soulzaa
# Worker concurrency per queue, default retry attempts, metrics sampling interval.
QUEUE_CONCURRENCY=5
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_METRICS_INTERVAL_MS=15000
# Bull Board dashboard (served under the API prefix, e.g. /api/admin/queues).
# It mounts an Express router that bypasses Nest guards, so it is protected with
# HTTP Basic auth — CHANGE THE PASSWORD before exposing it, or front it with a proxy.
QUEUE_DASHBOARD_ROUTE=/admin/queues
QUEUE_DASHBOARD_USER=admin
QUEUE_DASHBOARD_PASSWORD=soulzaa

# ---- Observability ----
METRICS_ENABLED=true
# Slow-operation thresholds (ms) for warning/error logs + liveness event-loop lag.
SLOW_QUERY_WARN_MS=100
SLOW_QUERY_ERROR_MS=500
SLOW_REDIS_MS=50
SLOW_REQUEST_MS=1000
LIVENESS_MAX_EVENT_LOOP_LAG_MS=200
